---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import VenueGallery from '../components/VenueGallery.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import { getSportNames } from '../lib/sportarten';
import { nachOrder } from '../lib/reihenfolge';

const venues = (await getCollection('sportstaetten')).sort(nachOrder).map((eintrag) => eintrag.data);
const sportNames = await getSportNames();

/*
 * Formular mit daisyUI (fieldset, label, input, select, textarea) im
 * Vereinslook: Felder mit kleinem Radius auf hellgrünem Grund, beim Fokus
 * grüner Rand mit weichem Schein. Fehler setzt das Skript unten über
 * aria-invalid – die Rahmenfarbe hängt direkt an diesem Attribut.
 */
const feld = 'fieldset p-0 gap-[0.35rem] mb-4 text-step-0';
const beschriftung =
  'label gap-1 whitespace-normal text-base-content font-semibold text-[0.92rem] [&>span]:text-accent';
const eingabe =
  'w-full h-auto min-h-12 py-[0.7rem] px-[0.85rem] text-step-0 bg-base-200 border-border-strong rounded-sm ' +
  'transition-[border-color,box-shadow] duration-[160ms] ' +
  'focus:border-primary focus:outline-none focus:shadow-[0_0_0_3px_rgba(47,122,100,0.18)] ' +
  'aria-invalid:border-[#B3261E]';
const fehler = 'm-0 text-[0.85rem] font-semibold text-[#B3261E]';

/** Gelber Hinweiskasten (daisyUI-alert) über dem Formular. */
const hinweis =
  'alert bg-sun-soft text-[#5E4A0C] border-0 rounded-sm gap-2 py-[0.7rem] px-4 text-[0.88rem] leading-[1.6] mb-6';

/** Kontaktkarten in der Seitenspalte. */
const infoKarte = 'card bg-tint-green rounded-box p-6';
const infoTitel = 'text-[1rem] mt-0 mb-[0.3rem]';
const infoText = 'm-0 text-muted';
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zum VSV Rössing von 1897: Probetraining anfragen, Anfahrt zur Alfred-Stubenrauch-Sporthalle und zum VSV-Sportplatz."
>
  <PageHeader
    eyebrow="Kontakt"
    title="Schreib uns einfach"
    lead="Egal ob Probetraining, Mitgliedschaft oder eine Frage zum Verein – wir melden uns in der Regel innerhalb weniger Tage."
  />

  <section class="section">
    <div class="container grid grid-cols-[1.25fr_0.75fr] gap-[clamp(2rem,4vw,3.5rem)] items-start max-[900px]:grid-cols-1">
      <div class="card bg-base-100 rounded-lg p-[clamp(1.5rem,4vw,2.5rem)] shadow-sm" id="probetraining">
        <h2>Probetraining anfragen</h2>
        <p class={hinweis}>
          <Icon name="info" size={17} />
          <span>
            Noch kein Versand-Endpunkt angebunden: „Absenden" öffnet euer
            E-Mail-Programm mit fertig ausgefüllter Nachricht.
          </span>
        </p>

        <form data-contact-form data-recipient={site.email} novalidate>
          <div class={feld}>
            <label class={beschriftung} for="name">Name <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
              aria-describedby="name-error"
              class={`input ${eingabe}`}
            />
            <p class={fehler} id="name-error" hidden></p>
          </div>

          <div class={feld}>
            <label class={beschriftung} for="email">E-Mail <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
              aria-describedby="email-error"
              class={`input ${eingabe}`}
            />
            <p class={fehler} id="email-error" hidden></p>
          </div>

          <div class={feld}>
            <label class={beschriftung} for="sportart">Welche Sportart interessiert dich?</label>
            <select id="sportart" name="sportart" class={`select ${eingabe} pr-7`}>
              <option value="">Bitte auswählen</option>
              {sportNames.map((name) => <option value={name}>{name}</option>)}
              <option value="Noch unsicher">Noch unsicher</option>
            </select>
          </div>

          <div class={feld}>
            <label class={beschriftung} for="nachricht">Nachricht</label>
            <textarea id="nachricht" name="nachricht" rows="5" class={`textarea ${eingabe} resize-y mb-2`}></textarea>
          </div>

          <p class="text-[0.82rem] text-muted">
            Mit dem Absenden stimmst du zu, dass wir deine Angaben zur
            Bearbeitung der Anfrage verwenden. Details in der
            <a href="/datenschutz/">Datenschutzerklärung</a>.
          </p>

          <button class="btn btn-accent" type="submit">
            <Icon name="mail" />
            Anfrage senden
          </button>

          <p class="mt-4 mb-0 text-[0.88rem] text-muted empty:hidden" role="status" data-form-status></p>
        </form>

        <noscript>
          <p class={hinweis}>
            <span>
              Ohne JavaScript funktioniert das Formular nicht. Schreibt uns
              stattdessen direkt an
              <a href={`mailto:${site.email}`}>{site.email}</a>.
            </span>
          </p>
        </noscript>
      </div>

      <aside class="flex flex-col gap-3">
        <h2 class="sr-only">Kontaktdaten</h2>

        <div class={infoKarte}>
          <Icon name="mail" size={20} class="text-primary mb-2" />
          <h3 class={infoTitel}>E-Mail</h3>
          <p class={`${infoText} text-[0.94rem]`}><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>

        <div class={infoKarte}>
          <Icon name="pin" size={20} class="text-primary mb-2" />
          <h3 class={infoTitel}>Sportstätten</h3>
          <ul class="list-none p-0 mt-0 mb-3 flex flex-col gap-3">
            {
              venues.map((ort) => (
                <li class="flex flex-col text-[0.92rem] leading-[1.35]">
                  <strong class="text-primary">{ort.name}</strong>
                  {ort.street && (
                    <span class="text-[0.84rem] text-muted">
                      {ort.street}, {ort.postalCode} {ort.city}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
          <p class={`${infoText} text-[0.85rem]`}>
            <a href="#sportstaetten">Alle Sportstätten mit Fotos ansehen</a>
          </p>
        </div>

        <div class={infoKarte}>
          <Icon name="instagram" size={20} class="text-primary mb-2" />
          <h3 class={infoTitel}>Social Media</h3>
          <p class={`${infoText} text-[0.94rem]`}>
            <a href={site.social.instagram.url} rel="noopener">
              {site.social.instagram.handle} auf Instagram
            </a>
          </p>
        </div>
      </aside>
    </div>
  </section>

  <VenueGallery />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form) {
    const showError = (field: HTMLInputElement, message: string) => {
      const error = document.getElementById(`${field.id}-error`);
      field.setAttribute('aria-invalid', 'true');
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const clearError = (field: HTMLInputElement) => {
      const error = document.getElementById(`${field.id}-error`);
      field.removeAttribute('aria-invalid');
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
    };

    const validate = (field: HTMLInputElement) => {
      if (!field.value.trim()) {
        showError(field, 'Bitte ausfüllen.');
        return false;
      }
      if (field.type === 'email' && !field.checkValidity()) {
        showError(field, 'Bitte eine gültige E-Mail-Adresse angeben.');
        return false;
      }
      clearError(field);
      return true;
    };

    const required = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[required]')
    );

    required.forEach((field) => {
      field.addEventListener('blur', () => validate(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      // Alle Pflichtfelder prüfen, damit der Fokus im ersten Fehler landet.
      const invalid = required.filter((field) => !validate(field));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') ?? '');
      const sportart = String(data.get('sportart') ?? '');
      const nachricht = String(data.get('nachricht') ?? '');

      const subject = sportart
        ? `Anfrage Probetraining: ${sportart}`
        : 'Anfrage über die Website';

      const body = [
        `Name: ${name}`,
        `E-Mail: ${String(data.get('email') ?? '')}`,
        sportart ? `Sportart: ${sportart}` : '',
        '',
        nachricht,
      ]
        .filter((line) => line !== null)
        .join('\n');

      const recipient = form.dataset.recipient ?? '';
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(
        subject
      )}&body=${encodeURIComponent(body)}`;

      if (status) {
        status.textContent =
          'Euer E-Mail-Programm sollte sich jetzt mit der fertigen Nachricht öffnen. Falls nicht, schreibt uns direkt an ' +
          recipient +
          '.';
      }
    });
  }
</script>
