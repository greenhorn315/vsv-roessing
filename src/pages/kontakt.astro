---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import VenueGallery from '../components/VenueGallery.astro';
import Container from '../components/Container.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import { getSportNames } from '../lib/sportarten';
import { nachOrder } from '../lib/reihenfolge';

const venues = (await getCollection('sportstaetten')).sort(nachOrder).map((eintrag) => eintrag.data);
const sportNames = await getSportNames();

/*
 * Formular mit daisyUI (fieldset, label, input, select, textarea) im
 * Vereinslook: Felder mit kleinem Radius auf hellgrünem Grund, beim Fokus
 * grüner Rand mit weichem Schein. Fehler setzt das Skript unten über
 * aria-invalid – die Rahmenfarbe hängt direkt an diesem Attribut.
 */
const feld = 'fieldset mb-4 p-0';
const beschriftung = 'label text-sm font-semibold whitespace-normal text-base-content';
const eingabe = 'w-full aria-invalid:border-error';
const fehler = 'text-sm font-semibold text-error';

/** Gelber Hinweiskasten (daisyUI-alert) über dem Formular. */
const hinweis = 'alert mb-6 border-0 bg-warning/20';

/** Kontaktkarten in der Seitenspalte. */
const infoKarte = 'card bg-base-300 p-6 text-base';
const infoTitel = 'mb-1 text-base';
const infoText = 'text-base-content/70';
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zum VSV Rössing von 1897: Probetraining anfragen, Anfahrt zur Alfred-Stubenrauch-Sporthalle und zum VSV-Sportplatz."
>
  <PageHeader
    eyebrow="Kontakt"
    title="Schreib uns einfach"
    lead="Egal ob Probetraining, Mitgliedschaft oder eine Frage zum Verein – wir melden uns in der Regel innerhalb weniger Tage."
  />

  <section class="py-16 md:py-20">
    <Container class="grid grid-cols-[1.25fr_0.75fr] items-start gap-8 md:gap-14 max-[900px]:grid-cols-1">
      <div class="card rounded-3xl bg-base-100 p-6 text-base shadow-sm md:p-10" id="probetraining">
        <h2 class="mb-4 text-3xl md:text-4xl">Probetraining anfragen</h2>
        <p class={hinweis}>
          <Icon name="info" size={17} />
          <span>
            Noch kein Versand-Endpunkt angebunden: „Absenden" öffnet euer
            E-Mail-Programm mit fertig ausgefüllter Nachricht.
          </span>
        </p>

        <form data-contact-form data-recipient={site.email} novalidate>
          <div class={feld}>
            <label class={beschriftung} for="name">Name <span class="text-accent" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
              aria-describedby="name-error"
              class={`input ${eingabe}`}
            />
            <p class={fehler} id="name-error" hidden></p>
          </div>

          <div class={feld}>
            <label class={beschriftung} for="email">E-Mail <span class="text-accent" aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
              aria-describedby="email-error"
              class={`input ${eingabe}`}
            />
            <p class={fehler} id="email-error" hidden></p>
          </div>

          <div class={feld}>
            <label class={beschriftung} for="sportart">Welche Sportart interessiert dich?</label>
            <select id="sportart" name="sportart" class={`select ${eingabe}`}>
              <option value="">Bitte auswählen</option>
              {sportNames.map((name) => <option value={name}>{name}</option>)}
              <option value="Noch unsicher">Noch unsicher</option>
            </select>
          </div>

          <div class={feld}>
            <label class={beschriftung} for="nachricht">Nachricht</label>
            <textarea id="nachricht" name="nachricht" rows="5" class={`textarea ${eingabe}`}></textarea>
          </div>

          <p class="mb-4 text-sm text-base-content/70">
            Mit dem Absenden stimmst du zu, dass wir deine Angaben zur
            Bearbeitung der Anfrage verwenden. Details in der{' '}
            <a class="link" href="/datenschutz/">Datenschutzerklärung</a>.
          </p>

          <button class="btn btn-accent" type="submit">
            <Icon name="mail" />
            Anfrage senden
          </button>

          <p class="mt-4 text-sm text-base-content/70 empty:hidden" role="status" data-form-status></p>
        </form>

        <noscript>
          <p class={hinweis}>
            <span>
              Ohne JavaScript funktioniert das Formular nicht. Schreibt uns
              stattdessen direkt an
              <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.
            </span>
          </p>
        </noscript>
      </div>

      <aside class="flex flex-col gap-3">
        <h2 class="sr-only">Kontaktdaten</h2>

        <div class={infoKarte}>
          <Icon name="mail" size={20} class="text-primary mb-2" />
          <h3 class={infoTitel}>E-Mail</h3>
          <p class={infoText}><a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>

        <div class={infoKarte}>
          <Icon name="pin" size={20} class="text-primary mb-2" />
          <h3 class={infoTitel}>Sportstätten</h3>
          <ul class="mb-3 flex flex-col gap-3">
            {
              venues.map((ort) => (
                <li class="flex flex-col text-sm leading-snug">
                  <strong class="text-primary">{ort.name}</strong>
                  {ort.street && (
                    <span class="text-base-content/70">
                      {ort.street}, {ort.postalCode} {ort.city}
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
          <p class={`${infoText} text-sm`}>
            <a class="link" href="#sportstaetten">Alle Sportstätten mit Fotos ansehen</a>
          </p>
        </div>

        <div class={infoKarte}>
          <Icon name="instagram" size={20} class="text-primary mb-2" />
          <h3 class={infoTitel}>Social Media</h3>
          <p class={infoText}>
            <a class="link" href={site.social.instagram.url} rel="noopener">
              {site.social.instagram.handle} auf Instagram
            </a>
          </p>
        </div>
      </aside>
    </Container>
  </section>

  <VenueGallery />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form) {
    const showError = (field: HTMLInputElement, message: string) => {
      const error = document.getElementById(`${field.id}-error`);
      field.setAttribute('aria-invalid', 'true');
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const clearError = (field: HTMLInputElement) => {
      const error = document.getElementById(`${field.id}-error`);
      field.removeAttribute('aria-invalid');
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
    };

    const validate = (field: HTMLInputElement) => {
      if (!field.value.trim()) {
        showError(field, 'Bitte ausfüllen.');
        return false;
      }
      if (field.type === 'email' && !field.checkValidity()) {
        showError(field, 'Bitte eine gültige E-Mail-Adresse angeben.');
        return false;
      }
      clearError(field);
      return true;
    };

    const required = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[required]')
    );

    required.forEach((field) => {
      field.addEventListener('blur', () => validate(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      // Alle Pflichtfelder prüfen, damit der Fokus im ersten Fehler landet.
      const invalid = required.filter((field) => !validate(field));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') ?? '');
      const sportart = String(data.get('sportart') ?? '');
      const nachricht = String(data.get('nachricht') ?? '');

      const subject = sportart
        ? `Anfrage Probetraining: ${sportart}`
        : 'Anfrage über die Website';

      const body = [
        `Name: ${name}`,
        `E-Mail: ${String(data.get('email') ?? '')}`,
        sportart ? `Sportart: ${sportart}` : '',
        '',
        nachricht,
      ]
        .filter((line) => line !== null)
        .join('\n');

      const recipient = form.dataset.recipient ?? '';
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(
        subject
      )}&body=${encodeURIComponent(body)}`;

      if (status) {
        status.textContent =
          'Euer E-Mail-Programm sollte sich jetzt mit der fertigen Nachricht öffnen. Falls nicht, schreibt uns direkt an ' +
          recipient +
          '.';
      }
    });
  }
</script>
