---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site, venues } from '../data/site';
import { sports } from '../data/sports';
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zum VSV Rössing von 1897: Probetraining anfragen, Anfahrt zur Alfred-Stubenrauch-Sporthalle und zum VSV-Sportplatz."
>
  <PageHeader
    eyebrow="Kontakt"
    title="Schreib uns einfach"
    lead="Egal ob Probetraining, Mitgliedschaft oder eine Frage zum Verein – wir melden uns in der Regel innerhalb weniger Tage."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="form-wrap" id="probetraining">
        <h2>Probetraining anfragen</h2>
        <p class="form-note">
          <Icon name="info" size={17} />
          Noch kein Versand-Endpunkt angebunden: „Absenden" öffnet euer
          E-Mail-Programm mit fertig ausgefüllter Nachricht.
        </p>

        <form class="contact-form" data-contact-form data-recipient={site.email} novalidate>
          <div class="field">
            <label for="name">Name <span aria-hidden="true">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
              aria-describedby="name-error"
            />
            <p class="field__error" id="name-error" hidden></p>
          </div>

          <div class="field">
            <label for="email">E-Mail <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
              aria-describedby="email-error"
            />
            <p class="field__error" id="email-error" hidden></p>
          </div>

          <div class="field">
            <label for="sportart">Welche Sportart interessiert dich?</label>
            <select id="sportart" name="sportart">
              <option value="">Bitte auswählen</option>
              {sports.map((sport) => <option value={sport.name}>{sport.name}</option>)}
              <option value="Noch unsicher">Noch unsicher</option>
            </select>
          </div>

          <div class="field">
            <label for="nachricht">Nachricht</label>
            <textarea id="nachricht" name="nachricht" rows="5"></textarea>
          </div>

          <p class="privacy">
            Mit dem Absenden stimmst du zu, dass wir deine Angaben zur
            Bearbeitung der Anfrage verwenden. Details in der
            <a href="/datenschutz">Datenschutzerklärung</a>.
          </p>

          <button class="btn btn--primary" type="submit">
            <Icon name="mail" />
            Anfrage senden
          </button>

          <p class="form-fallback" role="status" data-form-status></p>
        </form>

        <noscript>
          <p class="form-note">
            Ohne JavaScript funktioniert das Formular nicht. Schreibt uns
            stattdessen direkt an
            <a href={`mailto:${site.email}`}>{site.email}</a>.
          </p>
        </noscript>
      </div>

      <aside class="contact-aside">
        <h2 class="visually-hidden">Kontaktdaten</h2>

        <div class="info-card">
          <Icon name="mail" size={20} class="info-card__icon" />
          <h3>E-Mail</h3>
          <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>

        <div class="info-card">
          <Icon name="pin" size={20} class="info-card__icon" />
          <h3>Sportstätten</h3>
          <ul class="orte">
            {
              venues.map((ort) => (
                <li>
                  <strong>{ort.name}</strong>
                  {ort.alias && <span class="orte__alias">auch {ort.alias}</span>}
                  {ort.street && (
                    <span>
                      {ort.street}, {ort.postalCode} {ort.city}
                    </span>
                  )}
                  <span class="orte__was">{ort.note}</span>
                </li>
              ))
            }
          </ul>
          <p class="info-card__hint">Parkplätze direkt an Halle und Platz.</p>
        </div>

        <div class="info-card">
          <Icon name="instagram" size={20} class="info-card__icon" />
          <h3>Social Media</h3>
          <p>
            <a href={site.social.instagram.url} rel="noopener">
              {site.social.instagram.handle} auf Instagram
            </a>
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  .form-wrap {
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--shadow-sm);
  }

  .form-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: #5E4A0C;
    background: var(--c-sun-soft);
    border-radius: var(--radius-sm);
    padding: 0.7rem 1rem;
    margin-bottom: var(--sp-5);
  }

  .field {
    margin-bottom: var(--sp-4);
  }
  .field label {
    display: block;
    font-weight: 600;
    font-size: 0.92rem;
    margin-bottom: 0.35rem;
  }
  .field label span {
    color: var(--c-accent-ink);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--c-primary);
    box-shadow: 0 0 0 3px rgba(47, 122, 100, 0.18);
    outline: none;
  }

  .field__error {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: #B3261E;
  }
  .field input[aria-invalid='true'],
  .field select[aria-invalid='true'],
  .field textarea[aria-invalid='true'] {
    border-color: #B3261E;
  }

  .form-fallback:empty {
    display: none;
  }
  .form-fallback {
    margin: var(--sp-4) 0 0;
    font-size: 0.88rem;
    color: var(--c-text-muted);
  }

  .privacy {
    font-size: 0.82rem;
    color: var(--c-text-muted);
  }

  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .info-card {
    background: var(--c-tint-green);
    border-radius: var(--radius);
    padding: var(--sp-5);
  }
  .info-card :global(.info-card__icon) {
    color: var(--c-primary);
    margin-bottom: var(--sp-2);
  }
  .info-card h3 {
    font-size: 1rem;
    margin: 0 0 0.3rem;
  }
  .info-card p {
    margin: 0;
    font-size: 0.94rem;
    color: var(--c-text-muted);
  }
  .orte {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .orte li {
    display: flex;
    flex-direction: column;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .orte strong {
    color: var(--c-primary);
  }
  .orte__alias,
  .orte__was {
    font-size: 0.84rem;
    color: var(--c-text-muted);
  }
  .orte__was {
    font-style: italic;
  }

  .info-card__hint {
    margin-top: 0.5rem !important;
    font-size: 0.85rem !important;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form) {
    const showError = (field: HTMLInputElement, message: string) => {
      const error = document.getElementById(`${field.id}-error`);
      field.setAttribute('aria-invalid', 'true');
      if (error) {
        error.textContent = message;
        error.hidden = false;
      }
    };

    const clearError = (field: HTMLInputElement) => {
      const error = document.getElementById(`${field.id}-error`);
      field.removeAttribute('aria-invalid');
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
    };

    const validate = (field: HTMLInputElement) => {
      if (!field.value.trim()) {
        showError(field, 'Bitte ausfüllen.');
        return false;
      }
      if (field.type === 'email' && !field.checkValidity()) {
        showError(field, 'Bitte eine gültige E-Mail-Adresse angeben.');
        return false;
      }
      clearError(field);
      return true;
    };

    const required = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[required]')
    );

    required.forEach((field) => {
      field.addEventListener('blur', () => validate(field));
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      // Alle Pflichtfelder prüfen, damit der Fokus im ersten Fehler landet.
      const invalid = required.filter((field) => !validate(field));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') ?? '');
      const sportart = String(data.get('sportart') ?? '');
      const nachricht = String(data.get('nachricht') ?? '');

      const subject = sportart
        ? `Anfrage Probetraining: ${sportart}`
        : 'Anfrage über die Website';

      const body = [
        `Name: ${name}`,
        `E-Mail: ${String(data.get('email') ?? '')}`,
        sportart ? `Sportart: ${sportart}` : '',
        '',
        nachricht,
      ]
        .filter((line) => line !== null)
        .join('\n');

      const recipient = form.dataset.recipient ?? '';
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(
        subject
      )}&body=${encodeURIComponent(body)}`;

      if (status) {
        status.textContent =
          'Euer E-Mail-Programm sollte sich jetzt mit der fertigen Nachricht öffnen. Falls nicht, schreibt uns direkt an ' +
          recipient +
          '.';
      }
    });
  }
</script>
