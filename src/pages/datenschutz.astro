---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LegalContent from '../components/LegalContent.astro';
import Icon from '../components/Icon.astro';
import Container from '../components/Container.astro';
import { getEntry, render } from 'astro:content';
import { isPrototype } from '../lib/site';

const datenschutz = await getEntry('rechtliches', 'datenschutz');
if (!datenschutz) throw new Error('src/content/rechtliches/datenschutz.md fehlt.');
const { Content } = await render(datenschutz);
---

<BaseLayout
  title="Datenschutz"
  description="Datenschutzerklärung des VSV Rössing von 1897 e.V."
>
  <PageHeader title="Datenschutzerklärung" />
  <section class="py-16 md:py-20">
    <Container>
      {
        isPrototype && (
          <aside class="alert mb-8 block max-w-3xl border-warning border-l-4 bg-warning/20 p-6 text-base">
            <p class="mb-2 flex items-center gap-2 font-bold">
              <Icon name="info" size={18} />
              Entwurf, noch nicht rechtlich geprüft
            </p>
            <p>
              Dieser Text beschreibt die Verarbeitung auf dieser Entwurfsseite.
              Vor dem Livegang gehört er geprüft und um die Angaben zum
              Hosting-Anbieter ergänzt.
            </p>
          </aside>
        )
      }

      <LegalContent><Content /></LegalContent>
    </Container>
  </section>
</BaseLayout>
