---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsList from '../components/NewsList.astro';
import Facts from '../components/Facts.astro';
import CallToAction from '../components/CallToAction.astro';
import Container from '../components/Container.astro';
import SectionHead from '../components/SectionHead.astro';
import VenueGallery from '../components/VenueGallery.astro';
import { site } from '../lib/site';
import { getSportCountWord } from '../lib/sportarten';
import { getCollection } from 'astro:content';

const vorstand = (await getCollection('vorstand')).sort(
  (a, b) => a.data.order - b.data.order,
);
const sportCountWord = await getSportCountWord();
---

<BaseLayout
  title="Verein"
  description="Der VSV Rössing von 1897 e.V.: Geschichte, Vorstand, Sportstätten mit Adressen und Fotos, Aktuelles aus dem Vereinsleben."
>
  <PageHeader
    eyebrow="Über uns"
    title="Seit 1897 in Bewegung"
    lead={`Was als kleiner Turnverein begann, ist heute ein Verein mit rund ${site.members} Mitgliedern und ${sportCountWord} Sportarten – getragen von Ehrenamt und Nachbarschaft.`}
  />

  <Facts />

  <section class="py-16 md:py-20">
    <Container class="grid grid-cols-[1.4fr_1fr] items-start gap-8 md:gap-16 max-[900px]:grid-cols-1">
      <div class="space-y-4">
        <SectionHead title="Unsere Geschichte" class="mb-6" />
        <p>
          Die Volkssportvereinigung Rössing wurde {site.founded} gegründet. Aus
          dem Turnbetrieb der Gründerjahre ist über Generationen ein
          Breitensportverein geworden, der heute vom Bambini-Fußball bis zum
          Dart-Abend alles unter einem Dach vereint.
        </p>
        <p>
          Trainiert wird in der Alfred-Stubenrauch-Sporthalle und auf dem
          VSV-Sportplatz. Getragen wird das alles von Menschen, die ihre
          Freizeit investieren – Übungsleiterinnen, Betreuer, Vorstand und
          viele helfende Hände rund um Turniere und Feste.
        </p>
        <p class="alert border-dashed border-warning bg-warning/20">
          Dieser Abschnitt ist ein Platzhalter und wird noch durch die
          Vereinschronik ersetzt.
        </p>
      </div>

      <div>
        <SectionHead title="Vorstand" class="mb-6" />
        <ul class="flex flex-col gap-2.5">
          {
            vorstand.map(({ data: person }) => (
              <li class="flex justify-between gap-3 rounded-xl border border-base-300 bg-base-100 px-4 py-3">
                <strong class="text-primary font-semibold">{person.role}</strong>
                {person.name ? (
                  <span class="text-base-content/70">{person.name}</span>
                ) : (
                  <span class="italic text-base-content/70">Name folgt</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <VenueGallery />

  <section class="pb-16 md:pb-20">
    <Container>
      <SectionHead title="Aktuelles" />
      <NewsList />
    </Container>
  </section>

  <CallToAction
    title="Lust, mitzugestalten?"
    text="Ob Übungsleitung, Turnierhilfe oder Kuchenblech – wir freuen uns über jede Hand."
  />
</BaseLayout>

