---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsList from '../components/NewsList.astro';
import Facts from '../components/Facts.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../data/site';

const board = [
  { role: '1. Vorsitz', name: 'Name folgt' },
  { role: '2. Vorsitz', name: 'Name folgt' },
  { role: 'Kassenwart', name: 'Name folgt' },
  { role: 'Schriftführung', name: 'Name folgt' },
];
---

<BaseLayout
  title="Verein"
  description="Der VSV Rössing von 1897 e.V.: Geschichte, Vorstand und Aktuelles aus dem Vereinsleben."
>
  <PageHeader
    eyebrow="Über uns"
    title="Seit 1897 in Bewegung"
    lead="Was als kleiner Turnverein begann, ist heute ein Verein mit rund 660 Mitgliedern und acht Sparten – getragen von Ehrenamt und Nachbarschaft."
  />

  <Facts />

  <section class="section">
    <div class="container split">
      <div>
        <div class="section-head">
          <h2>Unsere Geschichte</h2>
        </div>
        <p>
          Die Volkssportvereinigung Rössing wurde {site.founded} gegründet. Aus
          dem Turnbetrieb der Gründerjahre ist über Generationen ein
          Breitensportverein geworden, der heute vom Bambini-Fußball bis zum
          Dart-Abend alles unter einem Dach vereint.
        </p>
        <p>
          Trainiert wird in der Alfred-Stubenrauch-Sporthalle und auf dem
          VSV-Sportplatz. Getragen wird das alles von Menschen, die ihre
          Freizeit investieren – Übungsleiterinnen, Betreuer, Vorstand und
          viele helfende Hände rund um Turniere und Feste.
        </p>
        <p class="placeholder-note">
          Dieser Abschnitt ist ein Platzhalter und wird noch durch die
          Vereinschronik ersetzt.
        </p>
      </div>

      <div>
        <div class="section-head">
          <h2>Vorstand</h2>
        </div>
        <ul class="board">
          {
            board.map((person) => (
              <li>
                <strong>{person.role}</strong>
                <span>{person.name}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container narrow">
      <div class="section-head">
        <h2>Aktuelles</h2>
      </div>
      <NewsList />
    </div>
  </section>

  <CallToAction
    title="Lust, mitzugestalten?"
    text="Ob Übungsleitung, Turnierhilfe oder Kuchenblech – wir freuen uns über jede Hand."
  />
</BaseLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; }
  }

  .board {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .board li {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: 0.8rem 1rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
  }
  .board strong {
    color: var(--c-primary);
    font-weight: 600;
  }
  .board span {
    color: var(--c-text-muted);
  }

  .placeholder-note {
    background: var(--c-sun-soft);
    border: 1px dashed #D8B44A;
    color: #5E4A0C;
    font-size: 0.86rem;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
  }
</style>
