---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsList from '../components/NewsList.astro';
import Facts from '../components/Facts.astro';
import CallToAction from '../components/CallToAction.astro';
import { site } from '../lib/site';
import { getSportCountWord } from '../lib/sportarten';
import { getCollection } from 'astro:content';

// Reihenfolge steht in der YAML-Datei als `order`; auf die Reihenfolge, in der
// eine Collection ihre Einträge liefert, verlässt sich das bewusst nicht.
const vorstand = (await getCollection('vorstand')).sort(
  (a, b) => a.data.order - b.data.order,
);
const sportCountWord = await getSportCountWord();
---

<BaseLayout
  title="Verein"
  description="Der VSV Rössing von 1897 e.V.: Geschichte, Vorstand und Aktuelles aus dem Vereinsleben."
>
  <PageHeader
    eyebrow="Über uns"
    title="Seit 1897 in Bewegung"
    lead={`Was als kleiner Turnverein begann, ist heute ein Verein mit rund ${site.members} Mitgliedern und ${sportCountWord} Sportarten – getragen von Ehrenamt und Nachbarschaft.`}
  />

  <Facts />

  <section class="section">
    <div class="container grid grid-cols-[1.4fr_1fr] gap-[clamp(2rem,5vw,4rem)] items-start max-[900px]:grid-cols-1">
      <div>
        <div class="section-head">
          <h2>Unsere Geschichte</h2>
        </div>
        <p>
          Die Volkssportvereinigung Rössing wurde {site.founded} gegründet. Aus
          dem Turnbetrieb der Gründerjahre ist über Generationen ein
          Breitensportverein geworden, der heute vom Bambini-Fußball bis zum
          Dart-Abend alles unter einem Dach vereint.
        </p>
        <p>
          Trainiert wird in der Alfred-Stubenrauch-Sporthalle und auf dem
          VSV-Sportplatz. Getragen wird das alles von Menschen, die ihre
          Freizeit investieren – Übungsleiterinnen, Betreuer, Vorstand und
          viele helfende Hände rund um Turniere und Feste.
        </p>
        <p class="alert border-dashed border-[#D8B44A] bg-sun-soft text-[#5E4A0C] rounded-sm py-[0.7rem] px-4 text-[0.86rem] leading-[1.6]">
          Dieser Abschnitt ist ein Platzhalter und wird noch durch die
          Vereinschronik ersetzt.
        </p>
      </div>

      <div>
        <div class="section-head">
          <h2>Vorstand</h2>
        </div>
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.6rem]">
          {
            vorstand.map(({ data: person }) => (
              <li class="flex justify-between gap-3 py-[0.8rem] px-4 bg-base-100 border border-border rounded-sm">
                <strong class="text-primary font-semibold">{person.role}</strong>
                {person.name ? (
                  <span class="text-muted">{person.name}</span>
                ) : (
                  /* Zurückhaltend wie im Organigramm: Die Stelle ist besetzt,
                     nur der Name fehlt noch – das soll nicht wie ein Mangel
                     schreien. */
                  <span class="text-muted italic">Name folgt</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container narrow">
      <div class="section-head">
        <h2>Aktuelles</h2>
      </div>
      <NewsList />
    </div>
  </section>

  <CallToAction
    title="Lust, mitzugestalten?"
    text="Ob Übungsleitung, Turnierhilfe oder Kuchenblech – wir freuen uns über jede Hand."
  />
</BaseLayout>

