---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { sections } from '../data/impressum';

/** Zerlegt eine Zeile an der Vereins-E-Mail, damit daraus ein Link wird. */
function splitAtEmail(line: string) {
  const index = line.indexOf(site.email);
  if (index === -1) return null;
  return {
    before: line.slice(0, index),
    after: line.slice(index + site.email.length),
  };
}
---

<BaseLayout title="Impressum" description="Impressum des VSV Rössing von 1897 e.V.">
  <PageHeader title="Impressum" />

  <section class="section legal">
    <div class="container">
      {
        sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            <p>
              {section.body.map((line, index) => {
                const parts = splitAtEmail(line);
                return (
                  <>
                    {index > 0 && <br />}
                    {parts ? (
                      <>
                        {parts.before}
                        <a href={`mailto:${site.email}`}>{site.email}</a>
                        {parts.after}
                      </>
                    ) : (
                      line
                    )}
                  </>
                );
              })}
            </p>
          </>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .legal .container {
    max-width: 720px;
  }
  .legal h2 {
    font-size: var(--step-1);
    margin-top: var(--sp-6);
  }
  .legal h2:first-child {
    margin-top: 0;
  }
  .legal p {
    color: var(--c-text-muted);
  }
</style>
