---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Pictogram from '../../components/Pictogram.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallToAction from '../../components/CallToAction.astro';
import DartSpielplan from '../../components/DartSpielplan.astro';
import FussballSpielplan from '../../components/FussballSpielplan.astro';
import Eintrittspreise from '../../components/Eintrittspreise.astro';
import Container from '../../components/Container.astro';
import { render } from 'astro:content';
import { getSports, type Sport } from '../../lib/sportarten';
import { trainingsOfSport } from '../../lib/trainings';
import { ageGroupLabels, sportColorVar } from '../../lib/labels';
import { site } from '../../lib/site';
import { brotkrumenKnoten, OG_HEIGHT, OG_WIDTH, type Brotkrume } from '../../lib/seo';

export async function getStaticPaths() {
  return (await getSports()).map((eintrag) => ({
    params: { slug: eintrag.id },
    props: { eintrag },
  }));
}

const { eintrag } = Astro.props as { eintrag: Sport };
const sport = { ...eintrag.data, slug: eintrag.id };
const { Content } = await render(eintrag);
const sports = (await getSports()).map(({ id, data }) => ({ ...data, slug: id }));
const sessions = await trainingsOfSport(sport.slug);

function telHref(nummer: string) {
  const ziffern = nummer.replace(/[^\d+]/g, '');
  if (ziffern.startsWith('+')) return `tel:${ziffern}`;
  return `tel:+49${ziffern.replace(/^0/, '')}`;
}

const index = sports.findIndex((s) => s.slug === sport.slug);
const next = sports[(index + 1) % sports.length];
const previous = sports[(index - 1 + sports.length) % sports.length];

const brotkrumen: Brotkrume[] = [
  { label: 'Start', href: '/' },
  { label: 'Sportangebote', href: '/sportangebote/' },
  { label: sport.name },
];

const mitVerein = `${sport.name} beim ${site.shortName}: ${sport.description}`;
const description = mitVerein.length <= 160 ? mitVerein : sport.description;

const zeile = 'flex gap-3 border-t border-base-300 py-4';
const zeilenIcon = 'mt-0.5 shrink-0 text-secondary';
const zeilenTitel = 'mb-1 font-sans text-xs font-bold tracking-wider uppercase text-base-content/70';

const seite = new URL(Astro.url.pathname, Astro.site);
const jsonLd = [brotkrumenKnoten(brotkrumen, seite)];
---

<BaseLayout
  title={sport.name}
  description={description}
  ogImage={{
    src: `/og/${sport.slug}.png`,
    alt: `${sport.name} beim ${site.name} – mit dem DOSB-Piktogramm der Sportart`,
    width: OG_WIDTH,
    height: OG_HEIGHT,
  }}
  jsonLd={jsonLd}
>
  <Container>
    <Breadcrumbs items={brotkrumen} />
  </Container>

  <section
    class="border-t-4 border-(--sport-color) bg-base-300 py-8 md:py-12"
    style={`--sport-color:${sportColorVar(sport.color)}`}
  >
    <Container class="flex items-start gap-6 max-[620px]:flex-col">
      <span class="block w-22 shrink-0" aria-hidden="true">
        <Pictogram name={sport.pictogram} size={88} />
      </span>
      <div>
        <h1 class="mb-2 text-4xl md:text-5xl">{sport.name}</h1>
        <p class="mb-4 max-w-[60ch] text-lg text-base-content/70 md:text-xl">{sport.description}</p>
        <ul class="flex flex-wrap gap-1.5">
          {
            sport.ageGroups.map((group) => (
              <li class="badge border-0 bg-base-100 font-semibold text-primary">
                {ageGroupLabels[group]}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container class="grid grid-cols-[1.3fr_0.7fr] items-start gap-8 md:gap-14 max-[900px]:grid-cols-1">
      <div>
        {
          sport.status && (
            <aside class="alert mb-8 block border-warning border-l-4 bg-warning/20 p-6 text-base">
              <p class="mb-3 flex items-center gap-2 text-xs font-bold tracking-wider uppercase">
                <Icon name="info" size={17} />
                {sport.status.label}
              </p>
              <p>{sport.status.text}</p>
              {sport.status.next && (
                <>
                  <h2 class="mt-6 mb-2 font-sans text-xs font-bold tracking-wider uppercase text-base-content">
                    Als Nächstes geplant
                  </h2>
                  <ul class="flex flex-col gap-2">
                    {sport.status.next.map((item) => (
                      <li class="flex items-start gap-2 leading-snug">
                        <Icon name="calendar" size={17} class="mt-0.5 shrink-0 text-primary" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </aside>
          )
        }

        <div class="prose max-w-none text-base-content/70">
          <Content />
        </div>

        {
          sport.highlights && (
            <>
              <h2 class="mt-8 mb-4 text-2xl">Das erwartet dich</h2>
              <ul class="flex flex-col gap-2.5">
                {sport.highlights.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" size={18} strokeWidth={2.6} class="mt-0.5 text-secondary" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          sport.activities && sport.activities.length > 0 && (
            <>
              <h2 class="mt-8 mb-4 text-2xl">Das gehört dazu</h2>
              <ul class="grid grid-cols-[repeat(auto-fill,minmax(110px,1fr))] gap-4">
                {sport.activities.map((activity) => (
                  <li class="flex flex-col items-center gap-2 text-center">
                    <Pictogram name={activity.pictogram} size={64} />
                    <span class="text-sm leading-tight font-semibold">
                      {activity.name}
                      {activity.note && (
                        <small class="block text-xs font-normal text-base-content/70">{activity.note}</small>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <div class="mt-10">
          <a class="btn btn-lg btn-accent" href="/kontakt/#probetraining">
            <Icon name="sport" />
            Probetraining bei {sport.name} anfragen
          </a>
        </div>
      </div>

      <aside class="card sticky top-22 rounded-3xl border border-base-300 bg-base-100 p-6 text-base max-[900px]:static">
        <h2 class="mb-6 text-xl">Auf einen Blick</h2>

        <div class="flex gap-3 pb-4">
          <Icon name="clock" size={19} class={zeilenIcon} />
          <div>
            <h3 class={zeilenTitel}>
              Trainingszeiten
            </h3>
            {
              sessions.length > 0 ? (
                <ul class="flex flex-col gap-1.5">
                  {sessions.map((session) => (
                    <li class="flex flex-col [&>span]:text-sm [&>span]:text-base-content/70">
                      <strong class="text-primary">
                        {session.day} {session.time}
                      </strong>
                      <span>{session.title}</span>
                      {session.audience && <span>{session.audience}</span>}
                      {session.trainers && session.trainers.length > 0 && (
                        <span>Übungsleitung: {session.trainers.join(', ')}</span>
                      )}
                      {session.note && <span>{session.note}</span>}
                      {session.place && <span>{session.place}</span>}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-base-content/70">
                  Termine erfragt ihr am besten kurz per E-Mail – wir melden uns
                  mit der passenden Gruppe.
                </p>
              )
            }
          </div>
        </div>

        {
          sport.venue && (
            <div class={zeile}>
              <Icon name="pin" size={19} class={zeilenIcon} />
              <div>
                <h3 class={zeilenTitel}>
                  Wo
                </h3>
                <p class="text-base-content/70">{sport.venue}</p>
              </div>
            </div>
          )
        }

        {
          sport.bring && (
            <div class={zeile}>
              <Icon name="join" size={19} class={zeilenIcon} />
              <div>
                <h3 class={zeilenTitel}>
                  Mitbringen
                </h3>
                <p class="text-base-content/70">{sport.bring}</p>
              </div>
            </div>
          )
        }

        <div class={zeile}>
          <Icon name="mail" size={19} class={zeilenIcon} />
          <div class="text-base-content/70">
            <h3 class={zeilenTitel}>
              Ansprechpartner
            </h3>
            {
              sport.contact ? (
                <>
                  <p class="font-semibold text-base-content">{sport.contact.name}</p>
                  {sport.contact.role && <p class="mb-1.5 text-sm">{sport.contact.role}</p>}
                  {sport.contact.email && (
                    <p>
                      <a class="link" href={`mailto:${sport.contact.email}`}>{sport.contact.email}</a>
                    </p>
                  )}
                  {sport.contact.phone && (
                    <p>
                      <a class="link" href={telHref(sport.contact.phone)}>{sport.contact.phone}</a>
                    </p>
                  )}
                </>
              ) : (
                <p>
                  <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
                </p>
              )
            }
          </div>
        </div>
      </aside>
    </Container>
  </section>

  {
    /* Spielpläne als Server Island: gespielte Partien fallen ohne neuen Build heraus. */
  }
  {
    sport.slug === 'dart' && (
      <DartSpielplan server:defer>
        <DartSpielplan slot="fallback" />
      </DartSpielplan>
    )
  }
  {
    sport.slug === 'fussball' && (
      <FussballSpielplan server:defer>
        <FussballSpielplan slot="fallback" />
      </FussballSpielplan>
    )
  }
  {
    /* Statisch, nicht Teil der Island: Die Preise gelten auch, wenn gerade kein Spiel ansteht. */
  }
  {sport.slug === 'fussball' && <Eintrittspreise />}

  <nav class="border-t border-base-300 py-6" aria-label="Weitere Sportarten">
    <Container class="flex flex-wrap items-center justify-between gap-4 max-[620px]:justify-center max-[620px]:text-center">
      <a
        href={`/sportangebote/${previous.slug}/`}
        class="inline-flex items-center gap-2.5 font-semibold text-primary"
      >
        <Icon name="arrowRight" size={16} class="rotate-180" />
        <span>
          <small class="block text-xs font-normal tracking-wide uppercase text-base-content/70">
            Vorherige Sportart
          </small>
          {previous.name}
        </span>
      </a>
      <a href="/sportangebote/" class="link font-semibold link-accent">Alle Sportarten</a>
      <a
        href={`/sportangebote/${next.slug}/`}
        class="inline-flex items-center gap-2.5 text-right font-semibold text-primary"
      >
        <span>
          <small class="block text-xs font-normal tracking-wide uppercase text-base-content/70">
            Nächste Sportart
          </small>
          {next.name}
        </span>
        <Icon name="arrowRight" size={16} />
      </a>
    </Container>
  </nav>

  <CallToAction />
</BaseLayout>
