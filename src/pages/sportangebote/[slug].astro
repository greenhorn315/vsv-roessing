---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Pictogram from '../../components/Pictogram.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CallToAction from '../../components/CallToAction.astro';
import DartSpielplan from '../../components/DartSpielplan.astro';
import FussballSpielplan from '../../components/FussballSpielplan.astro';
import { render } from 'astro:content';
import { getSports, type Sport } from '../../lib/sportarten';
import { trainingsOfSport } from '../../lib/trainings';
import { ageGroupLabels, sportColorVar } from '../../lib/labels';
import { site } from '../../lib/site';
import { brotkrumenKnoten, spielKnoten, type Brotkrume } from '../../lib/seo';
import { OG_HEIGHT, OG_WIDTH } from '../../lib/og';

export async function getStaticPaths() {
  return (await getSports()).map((eintrag) => ({
    params: { slug: eintrag.id },
    props: { eintrag },
  }));
}

const { eintrag } = Astro.props as { eintrag: Sport };
// Angaben aus dem Kopf der Markdown-Datei, Slug aus dem Dateinamen.
const sport = { ...eintrag.data, slug: eintrag.id };
// Der Fließtext der Detailseite ist der Markdown-Inhalt unter den Angaben.
const { Content } = await render(eintrag);
const sports = (await getSports()).map(({ id, data }) => ({ ...data, slug: id }));
const sessions = await trainingsOfSport(sport.slug);

// Für die Weiter-Navigation am Seitenende.
/**
 * Deutsche Rufnummer in die internationale Schreibweise für tel:-Links.
 * Die führende Null ist die nationale Verkehrsausscheidungsziffer und
 * entfällt dabei.
 */
function telHref(nummer: string) {
  const ziffern = nummer.replace(/[^\d+]/g, '');
  if (ziffern.startsWith('+')) return `tel:${ziffern}`;
  return `tel:+49${ziffern.replace(/^0/, '')}`;
}

const index = sports.findIndex((s) => s.slug === sport.slug);
const next = sports[(index + 1) % sports.length];
const previous = sports[(index - 1 + sports.length) % sports.length];

const brotkrumen: Brotkrume[] = [
  { label: 'Start', href: '/' },
  { label: 'Sportangebote', href: '/sportangebote/' },
  { label: sport.name },
];

// Beschreibung für Suchmaschinen: mit Vereinsname, solange sie in die
// üblichen rund 160 Zeichen passt, sonst nur der Text der Sportart.
const mitVerein = `${sport.name} beim ${site.shortName}: ${sport.description}`;
const description = mitVerein.length <= 160 ? mitVerein : sport.description;

// Zeilen der Infokarte „Auf einen Blick“: Icon links, Titel und Text rechts.
const zeile = 'flex gap-3 py-4 border-t border-border';
const zeilenIcon = 'text-secondary mt-[0.15rem] shrink-0';
const zeilenTitel =
  'font-sans text-[0.82rem] font-bold uppercase tracking-[0.05em] text-muted mt-0 mb-[0.3rem]';

const seite = new URL(Astro.url.pathname, Astro.site);
const jsonLd = [
  brotkrumenKnoten(brotkrumen, seite),
  ...(await spielKnoten(sport.slug, sport.name, seite.origin)),
];
---

<BaseLayout
  title={sport.name}
  description={description}
  ogImage={{
    src: `/og/${sport.slug}.png`,
    alt: `${sport.name} beim ${site.name} – mit dem DOSB-Piktogramm der Sportart`,
    width: OG_WIDTH,
    height: OG_HEIGHT,
  }}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={brotkrumen} />
  </div>

  {/* Kopfband in der Farbe der Sportart (--sport-color) */}
  <section
    class="bg-tint-green py-[clamp(2rem,4vw,3rem)] border-t-4 border-(--sport-color)"
    style={`--sport-color:${sportColorVar(sport.color)}`}
  >
    <div class="container flex items-start gap-6 max-[620px]:flex-col">
      <span class="block w-[88px] shrink-0" aria-hidden="true">
        <Pictogram name={sport.pictogram} size={88} />
      </span>
      <div>
        <h1 class="mb-2">{sport.name}</h1>
        <p class="lead max-w-[60ch] mb-4">{sport.description}</p>
        <ul class="list-none flex flex-wrap gap-[0.4rem] p-0 m-0">
          {
            sport.ageGroups.map((group) => (
              <li class="badge h-auto border-0 rounded-full bg-base-100 text-primary text-[0.8rem] font-semibold leading-[1.6] px-3 py-1">
                {ageGroupLabels[group]}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-cols-[1.3fr_0.7fr] max-[900px]:grid-cols-1 gap-[clamp(2rem,4vw,3.5rem)] items-start">
      <div>
        {
          sport.status && (
            <aside class="alert alert-warning block bg-sun-soft border border-[#E8CE8A] border-l-[5px] border-l-sun rounded-box p-6 mb-8 text-step-0 leading-[1.6] text-base-content">
              <p class="flex items-center gap-[0.45rem] m-0 mb-3 text-[0.78rem] font-bold uppercase tracking-[0.06em] text-[#6B5400]">
                <Icon name="info" size={17} />
                {sport.status.label}
              </p>
              <p class="m-0 text-[#4A3D14]">{sport.status.text}</p>
              {sport.status.next && (
                <>
                  <h2 class="font-sans text-[0.82rem] font-bold uppercase tracking-[0.05em] text-[#6B5400] mt-6 mb-2 mx-0">
                    Als Nächstes geplant
                  </h2>
                  <ul class="list-none flex flex-col gap-2 p-0 m-0">
                    {sport.status.next.map((item) => (
                      <li class="flex items-start gap-[0.55rem] text-[#4A3D14] leading-[1.45]">
                        <Icon name="calendar" size={17} class="text-[#8A6D00] mt-[0.2rem] shrink-0" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </aside>
          )
        }

        {/* Fließtext aus der Markdown-Datei: Er trägt keine Klassen, deshalb
             erbt er die gedämpfte Textfarbe von diesem Rahmen. */}
        <div class="text-muted">
          <Content />
        </div>

        {
          sport.highlights && (
            <>
              <h2 class="text-step-2 mt-8">Das erwartet dich</h2>
              <ul class="list-none flex flex-col gap-[0.6rem] p-0 m-0">
                {sport.highlights.map((item) => (
                  <li class="flex items-start gap-[0.6rem]">
                    <Icon name="check" size={18} strokeWidth={2.6} class="text-secondary mt-[0.2rem]" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        {
          sport.activities && sport.activities.length > 0 && (
            <>
              <h2 class="text-step-2 mt-8">Das gehört dazu</h2>
              <ul class="list-none grid grid-cols-[repeat(auto-fill,minmax(110px,1fr))] gap-4 p-0 m-0">
                {sport.activities.map((activity) => (
                  <li class="flex flex-col items-center gap-2 text-center">
                    <Pictogram name={activity.pictogram} size={64} />
                    <span class="text-[0.92rem] font-semibold text-base-content leading-[1.25]">
                      {activity.name}
                      {activity.note && (
                        <small class="block text-[0.8rem] font-normal text-muted">{activity.note}</small>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            </>
          )
        }

        <div class="mt-11">
          <a class="btn btn-accent" href="/kontakt/#probetraining">
            <Icon name="sport" />
            Probetraining bei {sport.name} anfragen
          </a>
        </div>
      </div>

      {/* Infokarte: bleibt auf breiten Bildschirmen beim Scrollen stehen */}
      <aside class="card bg-base-100 border border-border rounded-lg p-6 sticky top-[calc(var(--spacing-header)+1rem)] max-[900px]:static">
        <h2 class="text-step-1 mt-0 mb-6">Auf einen Blick</h2>

        {/* Erste Zeile ohne Trennlinie */}
        <div class="flex gap-3 pb-4">
          <Icon name="clock" size={19} class={zeilenIcon} />
          <div>
            <h3 class={zeilenTitel}>
              Trainingszeiten
            </h3>
            {
              sessions.length > 0 ? (
                <ul class="list-none flex flex-col gap-[0.4rem] p-0 m-0">
                  {sessions.map((session) => (
                    <li class="flex flex-col text-[0.94rem] [&>span]:text-[0.84rem] [&>span]:text-muted">
                      <strong class="text-primary">
                        {session.day} {session.time}
                      </strong>
                      <span>{session.title}</span>
                      {session.audience && <span>{session.audience}</span>}
                      {session.trainers && session.trainers.length > 0 && (
                        <span>Übungsleitung: {session.trainers.join(', ')}</span>
                      )}
                      {session.note && <span>{session.note}</span>}
                      {session.place && <span>{session.place}</span>}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="m-0 text-[0.94rem] text-muted">
                  Termine erfragt ihr am besten kurz per E-Mail – wir melden uns
                  mit der passenden Gruppe.
                </p>
              )
            }
          </div>
        </div>

        {
          sport.venue && (
            <div class={zeile}>
              <Icon name="pin" size={19} class={zeilenIcon} />
              <div>
                <h3 class={zeilenTitel}>
                  Wo
                </h3>
                <p class="m-0 text-[0.94rem] text-muted">{sport.venue}</p>
              </div>
            </div>
          )
        }

        {
          sport.bring && (
            <div class={zeile}>
              <Icon name="join" size={19} class={zeilenIcon} />
              <div>
                <h3 class={zeilenTitel}>
                  Mitbringen
                </h3>
                <p class="m-0 text-[0.94rem] text-muted">{sport.bring}</p>
              </div>
            </div>
          )
        }

        <div class={zeile}>
          <Icon name="mail" size={19} class={zeilenIcon} />
          <div class="text-muted">
            <h3 class={zeilenTitel}>
              Ansprechpartner
            </h3>
            {
              sport.contact ? (
                <>
                  <p class="m-0 text-[0.94rem] font-semibold text-base-content">{sport.contact.name}</p>
                  {sport.contact.role && <p class="m-0 mb-[0.35rem] text-[0.86rem]">{sport.contact.role}</p>}
                  {sport.contact.email && (
                    <p class="m-0 text-[0.94rem]">
                      <a href={`mailto:${sport.contact.email}`}>{sport.contact.email}</a>
                    </p>
                  )}
                  {sport.contact.phone && (
                    <p class="m-0 text-[0.94rem]">
                      <a href={telHref(sport.contact.phone)}>{sport.contact.phone}</a>
                    </p>
                  )}
                </>
              ) : (
                <p class="m-0 text-[0.94rem]">
                  <a href={`mailto:${site.email}`}>{site.email}</a>
                </p>
              )
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  {sport.slug === 'dart' && <DartSpielplan />}
  {sport.slug === 'fussball' && <FussballSpielplan />}

  <nav class="border-t border-border py-6" aria-label="Weitere Sportarten">
    <div class="container flex flex-wrap items-center justify-between gap-4 max-[620px]:justify-center max-[620px]:text-center">
      <a
        href={`/sportangebote/${previous.slug}/`}
        class="inline-flex items-center gap-[0.6rem] no-underline text-primary font-semibold"
      >
        <Icon name="arrowRight" size={16} class="rotate-180" />
        <span>
          <small class="block text-[0.75rem] font-normal text-muted uppercase tracking-[0.04em]">
            Vorherige Sportart
          </small>
          {previous.name}
        </span>
      </a>
      <a href="/sportangebote/" class="btn btn-link">Alle Sportarten</a>
      <a
        href={`/sportangebote/${next.slug}/`}
        class="inline-flex items-center gap-[0.6rem] no-underline text-primary font-semibold text-right"
      >
        <span>
          <small class="block text-[0.75rem] font-normal text-muted uppercase tracking-[0.04em]">
            Nächste Sportart
          </small>
          {next.name}
        </span>
        <Icon name="arrowRight" size={16} />
      </a>
    </div>
  </nav>

  <CallToAction />
</BaseLayout>
