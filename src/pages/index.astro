---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Facts from '../components/Facts.astro';
import SportGrid from '../components/SportGrid.astro';
import Audiences from '../components/Audiences.astro';
import Membership from '../components/Membership.astro';
import NewsList from '../components/NewsList.astro';
import TrainingList from '../components/TrainingList.astro';
import Testimonials from '../components/Testimonials.astro';
import SocialStrip from '../components/SocialStrip.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import PrototypeNotice from '../components/PrototypeNotice.astro';
import Container from '../components/Container.astro';
import SectionHead from '../components/SectionHead.astro';
import { site, isPrototype } from '../lib/site';
import { getSportCountWordCapitalized } from '../lib/sportarten';

const SportCountWord = await getSportCountWordCapitalized();
---

<BaseLayout title={`${site.shortName} – Dein Verein, dein Sport`} bareTitle>
  {isPrototype && <PrototypeNotice />}
  <Hero />
  <Facts />

  <section class="py-16 md:py-20" id="sportangebote">
    <Container>
      <SectionHead eyebrow="Sportangebote" title="Für jede und jeden das passende Angebot">
        <p>
          {SportCountWord} Sportarten, ein Verein. Klick dich direkt zu dem, was dich
          interessiert – Trainingszeiten und Ansprechpartner stehen auf jeder
          einzelnen Seite.
        </p>
      </SectionHead>
      <SportGrid />
    </Container>
  </section>

  <section class="pb-16 md:pb-20">
    <Container>
      <Audiences />
    </Container>
  </section>

  <section class="py-16 md:py-20" id="mitgliedschaft">
    <Container>
      <Membership compact />
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container class="grid grid-cols-[1.3fr_1fr] items-start gap-8 md:gap-16 max-[900px]:grid-cols-1">
      <div>
        <SectionHead title="Aktuelles aus dem Verein" class="mb-6" />
        <NewsList limit={3} />
      </div>
      <div>
        <SectionHead title="Nächste Trainingszeiten" class="mb-6" />
        <TrainingList limit={6} />
        <a class="link mt-4 inline-flex items-center gap-1.5 font-semibold link-accent" href="/sportangebote/">
          Alle Trainingszeiten
          <Icon name="arrowRight" size={16} />
        </a>
      </div>
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container>
      <SectionHead eyebrow="Stimmen aus dem Verein" title="Warum unsere Mitglieder bleiben" />
      <Testimonials />
    </Container>
  </section>

  <CallToAction />

  <section class="py-16 md:py-20">
    <Container>
      <SectionHead eyebrow="Social" title="Folg uns auf Instagram">
        <p>
          Trainingsausschnitte, Turnierergebnisse und Vereinsleben –
          {site.social.instagram.handle}
        </p>
      </SectionHead>
      <SocialStrip />
    </Container>
  </section>
</BaseLayout>
