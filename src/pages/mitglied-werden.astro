---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Membership from '../components/Membership.astro';
import Icon from '../components/Icon.astro';
import Container from '../components/Container.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../lib/site';
import { getDownloads } from '../lib/mitgliedschaft';

const downloads = await getDownloads();

const groesse = (bytes: number) => `${Math.round(bytes / 1024)} KB`;
---

<BaseLayout
  title="Mitglied werden"
  description="Mitglied beim VSV Rössing werden: 4 € im Monat für Kinder und Jugendliche, 7,50 € einzeln, 15 € für Familien. Formulare als PDF, Probetraining kostenlos."
>
  <PageHeader
    eyebrow="Mitglied werden"
    title="Dabei sein kostet weniger, als du denkst"
    lead="Kinder und Jugendliche 4 € im Monat, Familien 15 € – egal wie viele Kinder. Und vorher könnt ihr jede Sportart kostenlos ausprobieren."
  />

  <section class="py-16 md:py-20">
    <Container>
      <Membership />
    </Container>
  </section>

  <section class="pb-16 md:pb-20" id="formulare">
    <Container>
      <SectionHead eyebrow="Formulare & Downloads" title="Alle Unterlagen an einem Ort">
        <p>
          Alle Formulare als PDF zum Ausdrucken. Für den Eintritt genügt der
          Aufnahmeantrag – das SEPA-Mandat ist darin schon enthalten.
        </p>
      </SectionHead>

      <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] gap-4">
        {
          downloads.map((form) => (
            <li class="card flex-row items-start gap-4 border border-base-300 bg-base-100 p-6 text-base">
              <Icon name="download" size={22} class="mt-0.5 text-secondary" />
              <div>
                <h3 class="mb-1 text-base text-base-content">
                  <a class="link" href={form.file} download>
                    {form.title}
                  </a>
                </h3>
                <p class="text-sm text-base-content/70">{form.text}</p>
                <p class="mt-1.5 text-xs text-base-content/70">
                  PDF · {form.pages === 1 ? '1 Seite' : `${form.pages} Seiten`} ·{' '}
                  {groesse(form.bytes)}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 flex items-center gap-2 text-base-content/70">
        <Icon name="mail" size={17} />
        Unterlagen anfordern: <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </Container>
  </section>
</BaseLayout>

