---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Membership from '../components/Membership.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
import { getDownloads } from '../lib/mitgliedschaft';

const downloads = await getDownloads();

/** „138441“ liest sich schlecht – „135 KB“ schon. */
const groesse = (bytes: number) => `${Math.round(bytes / 1024)} KB`;
---

<BaseLayout
  title="Mitglied werden"
  description="Mitglied beim VSV Rössing werden: 4 € im Monat für Kinder und Jugendliche, 7,50 € einzeln, 15 € für Familien. Formulare als PDF, Probetraining kostenlos."
>
  <PageHeader
    eyebrow="Mitglied werden"
    title="Dabei sein kostet weniger, als du denkst"
    lead="Kinder und Jugendliche 4 € im Monat, Familien 15 € – egal wie viele Kinder. Und vorher könnt ihr jede Sportart kostenlos ausprobieren."
  />

  <section class="section">
    <div class="container">
      <Membership />
    </div>
  </section>

  <section class="section--tight" id="formulare">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Formulare &amp; Downloads</p>
        <h2>Alle Unterlagen an einem Ort</h2>
        <p>
          Alle Formulare als PDF zum Ausdrucken. Für den Eintritt genügt der
          Aufnahmeantrag – das SEPA-Mandat ist darin schon enthalten.
        </p>
      </div>

      <ul class="list-none p-0 m-0 grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-4">
        {
          downloads.map((form) => (
            <li class="card flex-row items-start gap-4 bg-base-100 border border-border rounded-box p-6">
              <Icon name="download" size={22} class="text-secondary mt-[0.15rem]" />
              <div>
                <h3 class="text-[1.02rem] mt-0 mb-[0.2rem] text-base-content">
                  <a href={form.file} download>
                    {form.title}
                  </a>
                </h3>
                <p class="m-0 text-[0.9rem] text-muted">{form.text}</p>
                <p class="mt-[0.35rem] mb-0 text-[0.8rem] tracking-[0.02em] text-muted">
                  PDF · {form.pages === 1 ? '1 Seite' : `${form.pages} Seiten`} ·{' '}
                  {groesse(form.bytes)}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="flex items-center gap-2 mt-6 text-muted">
        <Icon name="mail" size={17} />
        Unterlagen anfordern: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

