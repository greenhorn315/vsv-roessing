---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Membership from '../components/Membership.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { downloads } from '../data/membership';

/** „138441“ liest sich schlecht – „135 KB“ schon. */
const groesse = (bytes: number) => `${Math.round(bytes / 1024)} KB`;
---

<BaseLayout
  title="Mitglied werden"
  description="Mitglied beim VSV Rössing werden: 4 € im Monat für Kinder und Jugendliche, 7,50 € einzeln, 15 € für Familien. Alle Formulare als PDF und kostenloses Probetraining."
>
  <PageHeader
    eyebrow="Mitglied werden"
    title="Dabei sein kostet weniger, als du denkst"
    lead="Kinder und Jugendliche 4 € im Monat, Familien 15 € – egal wie viele Kinder. Und vorher könnt ihr jede Sportart kostenlos ausprobieren."
  />

  <section class="section">
    <div class="container">
      <Membership />
    </div>
  </section>

  <section class="section--tight" id="formulare">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Formulare &amp; Downloads</p>
        <h2>Alle Unterlagen an einem Ort</h2>
        <p>
          Alle Formulare als PDF zum Ausdrucken. Für den Eintritt genügt der
          Aufnahmeantrag – das SEPA-Mandat ist darin schon enthalten.
        </p>
      </div>

      <ul class="forms">
        {
          downloads.map((form) => (
            <li class="form-card">
              <Icon name="download" size={22} class="form-card__icon" />
              <div>
                <h3>
                  <a href={form.file} download>
                    {form.title}
                  </a>
                </h3>
                <p>{form.text}</p>
                <p class="form-card__meta">
                  PDF · {form.pages === 1 ? '1 Seite' : `${form.pages} Seiten`} ·{' '}
                  {groesse(form.bytes)}
                </p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="forms__hint">
        <Icon name="mail" size={17} />
        Unterlagen anfordern: <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .forms {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-4);
  }
  .form-card {
    display: flex;
    align-items: start;
    gap: var(--sp-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    padding: var(--sp-5);
  }
  .form-card :global(.form-card__icon) {
    color: var(--c-primary-light);
    margin-top: 0.15rem;
  }
  .form-card__meta {
    margin: 0.35rem 0 0 !important;
    font-size: 0.8rem;
    color: var(--c-text-muted);
    letter-spacing: 0.02em;
  }

  .form-card h3 {
    font-size: 1.02rem;
    margin: 0 0 0.2rem;
    color: var(--c-text);
  }
  .form-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-text-muted);
  }
  .forms__hint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--sp-5);
    color: var(--c-text-muted);
  }
</style>
