---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Diese Seite gibt es beim VSV Rössing nicht (mehr). Weiter geht es über die Startseite, die Sportangebote oder den Kontakt."
  noindex
>
  <section class="py-[clamp(3rem,8vw,6rem)]">
    <div class="container">
      <p class="eyebrow">Fehler 404</p>
      <h1>Diese Seite ist wohl ins Aus gegangen.</h1>
      <p class="lead">
        Die Adresse gibt es nicht (mehr). Von hier kommst du direkt weiter:
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-accent" href="/"><Icon name="home" />Zur Startseite</a>
        <a class="btn btn-outline" href="/sportangebote/">Sportangebote</a>
        <a class="btn btn-outline" href="/kontakt/">Kontakt</a>
      </div>
    </div>
  </section>
</BaseLayout>
