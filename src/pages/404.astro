---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Seite nicht gefunden">
  <section class="section notfound">
    <div class="container">
      <p class="eyebrow">Fehler 404</p>
      <h1>Diese Seite ist wohl ins Aus gegangen.</h1>
      <p class="lead">
        Die Adresse gibt es nicht (mehr). Von hier kommst du direkt weiter:
      </p>
      <div class="notfound__ctas">
        <a class="btn btn--primary" href="/"><Icon name="home" />Zur Startseite</a>
        <a class="btn btn--secondary" href="/sportangebote">Sportangebote</a>
        <a class="btn btn--secondary" href="/kontakt">Kontakt</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .notfound__ctas {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-6);
  }
</style>
