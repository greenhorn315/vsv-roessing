---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SportGrid from '../components/SportGrid.astro';
import ClubNumbers from '../components/ClubNumbers.astro';
import AudienceGuide from '../components/AudienceGuide.astro';
import Organigramm from '../components/Organigramm.astro';
import { SportCountWord, sportNames } from '../data/sports';
import TrainingList from '../components/TrainingList.astro';
import { trainingsStand } from '../data/trainings';
import CallToAction from '../components/CallToAction.astro';
---

<BaseLayout
  title="Sportangebote"
  description={`${SportCountWord} Sportarten beim VSV Rössing von 1897: ${sportNames.join(', ')} – für Kinder, Jugendliche und Erwachsene.`}
>
  <PageHeader
    eyebrow="Sportangebote"
    title={`${SportCountWord} Sportarten, ein Verein`}
    lead="Filtere nach Altersgruppe und finde in wenigen Sekunden das passende Angebot. Bei jeder Sparte gilt: Das erste Training ist kostenlos und unverbindlich."
  />

  <section class="section">
    <div class="container">
      <ClubNumbers />
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Für wen ist was?</p>
        <h2>Finde das Angebot, das zu dir passt</h2>
        <p>
          Dieselben Gruppen, nur andersherum sortiert: nicht nach Sparte,
          sondern nach der Person, die sucht.
        </p>
      </div>
      <AudienceGuide />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Nach Sparte</p>
        <h2>Alle Sparten im Überblick</h2>
      </div>
      <SportGrid withFilter detailed />
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Aufbau</p>
        <h2>Verein, Sparten, Gruppen</h2>
        <p>
          Vom Verein über die neun Sparten bis zu den einzelnen
          Trainingsgruppen.
        </p>
      </div>
      <Organigramm />
    </div>
  </section>

  <section class="section--tight">
    <div class="container narrow">
      <div class="section-head">
        <h2>Trainingszeiten im Überblick</h2>
        <p>Änderungen in den Ferien geben wir über Instagram und die Gruppen bekannt.</p>
        <p>{trainingsStand}</p>
      </div>
      <TrainingList grouped />
    </div>
  </section>

  <CallToAction />
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }
</style>
