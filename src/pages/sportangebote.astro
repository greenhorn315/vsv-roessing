---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SportGrid from '../components/SportGrid.astro';
import ClubNumbers from '../components/ClubNumbers.astro';
import AudienceGuide from '../components/AudienceGuide.astro';
import Organigramm from '../components/Organigramm.astro';
import { getSportCountWordCapitalized, getSportNames } from '../lib/sportarten';
import TrainingList from '../components/TrainingList.astro';
import { trainingsStand } from '../lib/trainings';
import CallToAction from '../components/CallToAction.astro';
import Container from '../components/Container.astro';
import SectionHead from '../components/SectionHead.astro';

const SportCountWord = await getSportCountWordCapitalized();
const sportNames = await getSportNames();
---

<BaseLayout
  title="Sportangebote"
  description={`${SportCountWord} Sportarten beim VSV Rössing: ${sportNames.join(', ')} – für jedes Alter.`}
>
  <PageHeader
    eyebrow="Sportangebote"
    title={`${SportCountWord} Sportarten, ein Verein`}
    lead="Filtere nach Altersgruppe und finde in wenigen Sekunden das passende Angebot. Bei jeder Sportart gilt: Das erste Training ist kostenlos und unverbindlich."
  />

  <section class="py-16 md:py-20">
    <Container>
      <ClubNumbers />
    </Container>
  </section>

  <section class="pb-16 md:pb-20">
    <Container>
      <SectionHead eyebrow="Für wen ist was?" title="Finde das Angebot, das zu dir passt">
        <p>
          Dieselben Gruppen, nur andersherum sortiert: nicht nach Sportart,
          sondern nach der Person, die sucht.
        </p>
      </SectionHead>
      <AudienceGuide />
    </Container>
  </section>

  <section class="py-16 md:py-20">
    <Container>
      <SectionHead eyebrow="Nach Sportart" title="Alle Sportarten im Überblick" />
      <SportGrid withFilter detailed />
    </Container>
  </section>

  <section class="pb-16 md:pb-20">
    <Container>
      <SectionHead eyebrow="Aufbau" title="Verein, Sportarten, Gruppen">
        <p>
          Vom Verein über die neun Sportarten bis zu den einzelnen
          Trainingsgruppen.
        </p>
      </SectionHead>
      <Organigramm />
    </Container>
  </section>

  <section class="pb-16 md:pb-20">
    <Container narrow>
      <SectionHead title="Trainingszeiten im Überblick">
        <p>Änderungen in den Ferien geben wir über Instagram und die Gruppen bekannt.</p>
        <p>{trainingsStand}</p>
      </SectionHead>
      <TrainingList grouped />
    </Container>
  </section>

  <CallToAction />
</BaseLayout>
