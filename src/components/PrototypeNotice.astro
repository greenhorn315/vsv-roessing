---
import Icon from './Icon.astro';
import Container from './Container.astro';
import { originalSiteUrl } from '../lib/site';
---

<aside class="alert alert-warning block rounded-none border-0 p-0 text-base" aria-labelledby="prototype-title">
  <Container class="flex items-center gap-4 py-4 max-[780px]:flex-wrap max-[780px]:gap-3">
    <span
      class="grid size-11 shrink-0 place-items-center rounded-full bg-base-100/60 max-[780px]:size-9"
      aria-hidden="true"
    >
      <Icon name="info" size={24} />
    </span>
    <div class="flex-auto max-[780px]:basis-60">
      <p class="font-bold" id="prototype-title">Entwurf – nicht die offizielle Vereinsseite</p>
      <p class="max-w-[70ch] text-sm">
        Diese Seite ist ein Prototyp und ein möglicher Nachfolger der
        bestehenden Website. Inhalte, Zahlen und Termine sind teilweise
        Platzhalter und noch nicht vom Verein freigegeben.
      </p>
    </div>
    <a class="btn shrink-0 btn-primary max-[780px]:w-full" href={originalSiteUrl} rel="noopener">
      Zur offiziellen Seite
      <Icon name="arrowRight" size={16} />
    </a>
  </Container>
</aside>
