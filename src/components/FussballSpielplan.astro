---
import Spielplan from './Spielplan.astro';
import { getSpielplan, kommendeSpiele } from '../lib/spielplan';
import { grossAnfang, zahlwort } from '../lib/labels';

// Partien und Kopfangaben stehen in src/content/spielplaene/fussball.yaml.
const plan = await getSpielplan('fussball');
const {
  team: fussballTeam,
  stand: fussballSpielplanStand,
  spielstaette: fussballSpielstaette,
} = plan;
if (!fussballTeam || !fussballSpielplanStand || !fussballSpielstaette) {
  throw new Error('fussball.yaml: „team“, „stand“ und „spielstaette“ werden gebraucht.');
}
const spiele = kommendeSpiele(plan.spiele);
const heimspiele = spiele.filter((spiel) => spiel.home).length;

// „ein“/„kein“ statt „eine“/„null“: Es folgt „Spiel“ bzw. „davon“.
const alsWort = (n: number) => zahlwort(n, { eins: 'ein', null: 'kein' });

const anzahl =
  spiele.length === 1
    ? 'Ein Spiel steht noch an'
    : `${grossAnfang(alsWort(spiele.length))} Spiele stehen noch an`;

const heim =
  heimspiele === 0
    ? 'alle davon auswärts'
    : heimspiele === spiele.length
      ? `alle auf dem ${fussballSpielstaette}`
      : `${alsWort(heimspiele)} davon auf dem ${fussballSpielstaette}`;

/** Eine gemeinsame Anstoßzeit lässt sich in einem Satz sagen. */
const anstoss = new Set(spiele.map((spiel) => spiel.time));
const zeitsatz = anstoss.size === 1 ? ` Angestoßen wird jeweils um ${[...anstoss][0]} Uhr.` : '';

const lead =
  `${anzahl}, ${heim}.${zeitsatz}` +
  ` Grundlage ist der Aushang am Sportplatz, Stand ${fussballSpielplanStand};` +
  ' gespielte Begegnungen fallen aus der Liste heraus.';
---

<Spielplan
  heading={`Spiele der ${fussballTeam}`}
  caption={`Kommende Spiele der ${fussballTeam} nach dem Aushang vom ${fussballSpielplanStand}`}
  spiele={spiele}
>
  {lead}
</Spielplan>
