---
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="pt-10 md:pt-16">
  <Container>
    {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-wider text-accent">{eyebrow}</p>}
    <h1 class="max-w-[18ch] text-3xl hyphens-auto sm:hyphens-manual sm:text-4xl md:text-5xl">{title}</h1>
    {lead && <p class="mt-4 max-w-[58ch] text-lg text-base-content/70 md:text-xl">{lead}</p>}
  </Container>
</section>
