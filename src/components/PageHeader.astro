---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 1rem + 5vw, 4rem) 0;
  }
  .page-header h1 {
    max-width: 18ch;
  }
  .page-header .lead {
    max-width: 58ch;
  }
</style>
