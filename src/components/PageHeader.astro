---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="pt-[clamp(2.5rem,1rem+5vw,4rem)]">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="max-w-[18ch]">{title}</h1>
    {lead && <p class="lead max-w-[58ch]">{lead}</p>}
  </div>
</section>
