---
import type { Brotkrume } from '../lib/seo';

// Die Seite reicht dieselben Einträge als BreadcrumbList an BaseLayout
// weiter (siehe brotkrumenKnoten in src/lib/seo.ts).
interface Props {
  items: Brotkrume[];
}

const { items } = Astro.props;
---

{/* daisyUI-breadcrumbs: Trenner zeichnet die Komponente selbst (für
   Screenreader unsichtbar). Umbrechen statt waagerecht zu scrollen, damit
   lange Titel auf dem Handy lesbar bleiben. daisyUI setzt einen eigenen
   Fokusrahmen; unser 3px-Korall-Rahmen wird ausdrücklich gesetzt. */}
<nav
  class="breadcrumbs overflow-visible pt-6 pb-0 text-[0.86rem] [&>ol]:flex-wrap [&>ol]:whitespace-normal"
  aria-label="Sie sind hier"
>
  <ol class="m-0 list-none">
    {
      items.map((item) =>
        item.href ? (
          <li>
            <a
              class="text-muted no-underline hover:text-primary hover:underline focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-3"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ) : (
          <li>
            <span class="cursor-default font-semibold text-primary hover:no-underline" aria-current="page">
              {item.label}
            </span>
          </li>
        )
      )
    }
  </ol>
</nav>
