---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="site-breadcrumbs" aria-label="Sie sind hier">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {index < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .site-breadcrumbs {
    padding-top: var(--sp-5);
  }
  .site-breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    font-size: 0.86rem;
  }
  .site-breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-breadcrumbs a {
    color: var(--c-text-muted);
    text-decoration: none;
  }
  .site-breadcrumbs a:hover {
    color: var(--c-primary);
    text-decoration: underline;
  }
  .site-breadcrumbs [aria-current='page'] {
    color: var(--c-primary);
    font-weight: 600;
  }
  .sep {
    color: var(--c-border-strong);
  }
</style>
