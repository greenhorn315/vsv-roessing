---
import type { Brotkrume } from '../lib/seo';

interface Props {
  items: Brotkrume[];
}

const { items } = Astro.props;
---

<nav
  class="breadcrumbs overflow-visible pt-6 pb-0 text-sm [&>ol]:flex-wrap [&>ol]:whitespace-normal"
  aria-label="Sie sind hier"
>
  <ol>
    {
      items.map((item) =>
        item.href ? (
          <li>
            <a
              class="text-base-content/70 hover:text-primary"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ) : (
          <li>
            <span class="font-semibold text-primary" aria-current="page">
              {item.label}
            </span>
          </li>
        )
      )
    }
  </ol>
</nav>
