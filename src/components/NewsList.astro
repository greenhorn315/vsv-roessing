---
import { getCollection } from 'astro:content';
import { nachOrder } from '../lib/reihenfolge';

interface Props {
  limit?: number;
}

/**
 * Meldungen aus src/content/news/, in der Reihenfolge ihres `order` – von
 * Hand gesetzt, siehe dort. Der Text ist der Inhalt unter den Angaben und
 * wird bewusst als schlichter Text gezeigt, nicht als Markdown gerendert:
 * Er steht in einem einzelnen Absatz der Liste.
 */
const news = (await getCollection('news'))
  .sort(nachOrder)
  .map(({ data, body }) => ({
    date: data.date.toISOString().slice(0, 10),
    title: data.title,
    text: (body ?? '').trim(),
  }));

const { limit = news.length } = Astro.props;
const items = news.slice(0, limit);

const dayFormat = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const monthFormat = new Intl.DateTimeFormat('de-DE', { month: 'short' });
const fullFormat = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' });
---

{/* daisyUI-list: Datum links, Meldung rechts, Linien zwischen den Einträgen. */}
<ul class="list">
  {
    items.map((item) => {
      const date = new Date(item.date);
      return (
        <li class="list-row gap-4 rounded-none border-t border-base-300 px-0 py-4 after:hidden last:border-b">
          <time
            class="w-14 text-center font-display leading-tight text-primary"
            datetime={item.date}
          >
            <span class="sr-only">{fullFormat.format(date)}</span>
            <strong class="block text-2xl" aria-hidden="true">{dayFormat.format(date)}</strong>
            <span class="text-xs tracking-wide uppercase text-base-content/70" aria-hidden="true">
              {monthFormat.format(date)}
            </span>
          </time>
          <div>
            <h3 class="mb-1 text-lg text-base-content">{item.title}</h3>
            <p class="text-base-content/70">{item.text}</p>
          </div>
        </li>
      );
    })
  }
</ul>
