---
import { calculator } from '../data/membership';

/**
 * Der Verein rechnet für eine Familie automatisch den günstigsten Beitrag ab.
 * Genau das bildet der Rechner nach: Einzelbeiträge zusammenzählen, und wenn
 * minderjährige Kinder dabei sind, bei 15 € deckeln. Ohne Kinder gibt es
 * keinen Deckel – zwei Erwachsene zahlen ohnehin dasselbe.
 */
---

<div class="calc" id="familienrechner">
  <h3 class="calc__title">Familienrechner</h3>
  <p class="calc__intro">
    Wer aus eurem Haushalt soll Mitglied werden?
  </p>

  <div
    class="calc__felder"
    data-rechner
    data-erwachsen={calculator.erwachsen}
    data-kind={calculator.kind}
    data-familie={calculator.familie}
  >
    <div class="calc__feld">
      <label class="calc__label" for="erwachsene">Erwachsene: <span data-wert="erwachsene">2</span></label>
      <input type="range" id="erwachsene" name="erwachsene" min="0" max="4" value="2" step="1" list="ticksErwachsene" />
      {/* Eigene Skala je Regler – eine gemeinsame erschiene nur einmal. */}
      <datalist id="ticksErwachsene">
        <option value="0" label="0"></option>
        <option value="1" label="1"></option>
        <option value="2" label="2"></option>
        <option value="3" label="3"></option>
        <option value="4" label="4+"></option>
      </datalist>
    </div>
    <div class="calc__feld">
      <label class="calc__label" for="kinder">Kinder und Jugendliche: <span data-wert="kinder">2</span></label>
      <input type="range" id="kinder" name="kinder" min="0" max="4" value="2" step="1" list="ticksKinder" />
      <datalist id="ticksKinder">
        <option value="0" label="0"></option>
        <option value="1" label="1"></option>
        <option value="2" label="2"></option>
        <option value="3" label="3"></option>
        <option value="4" label="4+"></option>
      </datalist>
    </div>
  </div>

  <!-- aria-live: Screenreader bekommen das neue Ergebnis mit. -->
  <output class="calc__result" aria-live="polite">
    <strong data-ergebnis>15,00 € / Monat</strong>
    <span data-hinweis>Familienbeitrag statt 23,00 € einzeln gerechnet</span>
  </output>

  <p class="calc__disclaimer">
    Abgebucht wird einmal im Jahr, jeweils am 1. Juni. Verbindlich sind die
    Sätze im Aufnahmeantrag.
  </p>
</div>

<style>
  .calc {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  .calc__title {
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .calc__intro {
    font-size: 0.94rem;
    color: var(--c-text-muted);
    margin-bottom: var(--sp-5);
  }

  .calc__felder {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--sp-4) var(--sp-5);
    margin-bottom: var(--sp-4);
  }

  .calc__label span {
    color: var(--c-primary);
  }

  .calc__label {
    display: block;
    font-weight: 600;
    font-size: 0.86rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    margin-bottom: var(--sp-2);
  }

  input[type='range'] {
    width: 100%;
    accent-color: var(--c-accent-ink);
    height: 32px;
    cursor: pointer;
  }

  datalist {
    display: flex;
    justify-content: space-between;
    padding-inline: 2px;
    font-size: 0.75rem;
    color: var(--c-text-muted);
    writing-mode: horizontal-tb;
  }

  .calc__hint {
    margin: var(--sp-2) 0 0;
    font-size: 0.9rem;
    color: var(--c-text-muted);
  }

  .calc__result {
    display: block;
    margin-top: var(--sp-4);
    padding: var(--sp-4);
    background: var(--c-primary);
    color: #fff;
    border-radius: var(--radius);
  }
  .calc__result strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .calc__result span {
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .calc__disclaimer {
    margin: var(--sp-4) 0 0;
    font-size: 0.8rem;
    color: var(--c-text-muted);
  }
</style>

<script>
  const feld = document.querySelector<HTMLElement>('[data-rechner]');
  const erwachsene = document.getElementById('erwachsene') as HTMLInputElement | null;
  const kinder = document.getElementById('kinder') as HTMLInputElement | null;
  const ergebnis = document.querySelector<HTMLElement>('[data-ergebnis]');
  const hinweis = document.querySelector<HTMLElement>('[data-hinweis]');

  if (feld && erwachsene && kinder && ergebnis && hinweis) {
    const satzErwachsen = Number(feld.dataset.erwachsen);
    const satzKind = Number(feld.dataset.kind);
    const satzFamilie = Number(feld.dataset.familie);

    const euro = new Intl.NumberFormat('de-DE', {
      style: 'currency',
      currency: 'EUR',
      minimumFractionDigits: 2,
    });

    const zeigeWert = (input: HTMLInputElement) => {
      const anzeige = document.querySelector<HTMLElement>(`[data-wert="${input.id}"]`);
      if (anzeige) anzeige.textContent = input.value === '4' ? '4 oder mehr' : input.value;
    };

    const rechne = () => {
      const a = Number(erwachsene.value);
      const k = Number(kinder.value);
      zeigeWert(erwachsene);
      zeigeWert(kinder);

      const einzeln = a * satzErwachsen + k * satzKind;
      // Der Familienbeitrag gilt für Familien mit minderjährigen Kindern.
      const gedeckelt = k > 0 ? Math.min(einzeln, satzFamilie) : einzeln;

      if (a + k === 0) {
        ergebnis.textContent = '–';
        hinweis.textContent = 'Wählt mindestens eine Person aus.';
        return;
      }

      ergebnis.textContent = `${euro.format(gedeckelt)} / Monat`;
      if (gedeckelt < einzeln) {
        hinweis.textContent =
          `Familienbeitrag statt ${euro.format(einzeln)} einzeln gerechnet – ` +
          `${euro.format(einzeln - gedeckelt)} weniger im Monat`;
      } else if (a + k === 1) {
        hinweis.textContent = 'Einzelbeitrag';
      } else {
        hinweis.textContent = 'Einzelbeiträge zusammengerechnet';
      }
    };

    erwachsene.addEventListener('input', rechne);
    kinder.addEventListener('input', rechne);
    rechne();
  }
</script>
