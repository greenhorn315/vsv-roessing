---
import Pictogram from './Pictogram.astro';
import { getSports } from '../lib/sportarten';
import { getTrainings } from '../lib/trainings';
import { sportColorVar } from '../lib/labels';
import { site } from '../lib/site';

const trainings = await getTrainings();
const zweige = (await getSports()).map(({ id, data }) => ({
  // Slug aus dem Dateinamen, alles Übrige aus den Angaben der Datei.
  sport: { ...data, slug: id },
  gruppen: trainings.filter((t) => t.sport === id),
}));
---

<div>
  <p class="w-max max-w-full mx-auto my-0 py-3 px-8 bg-primary text-white rounded-sm text-center">
    <strong class="block font-display text-step-1">{site.shortName}</strong>
    <span class="text-[0.82rem] text-white/78">{site.legalName}</span>
  </p>
  <span class="block w-0.5 h-[26px] mx-auto bg-border-strong" aria-hidden="true"></span>

  <ul class="list-none p-0 m-0 grid grid-cols-3 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1 gap-4">
    {
      zweige.map(({ sport, gruppen }) => (
        <li
          class="card bg-base-100 border border-border border-t-4 border-t-(--sport-color) rounded-t-none rounded-b-sm p-4"
          style={`--sport-color:${sportColorVar(sport.color)}`}
        >
          <div class="flex items-center gap-3">
            <Pictogram name={sport.pictogram} size={40} class="shrink-0" />
            <div>
              <h3 class="text-[1.1rem] m-0">
                <a class="no-underline hover:underline" href={`/sportangebote/${sport.slug}/`}>{sport.name}</a>
              </h3>
              <p class="m-0 text-[0.8rem] text-muted">
                {gruppen.length === 0
                  ? 'noch keine Gruppen'
                  : `${gruppen.length} ${gruppen.length === 1 ? 'Gruppe' : 'Gruppen'}`}
              </p>
            </div>
          </div>

          {
            gruppen.length > 0 && (
              <ul class="list-none p-0 m-0 mt-4 flex flex-col gap-[0.3rem]">
                {gruppen.map((g) => (
                  <li class="relative pl-3 text-[0.86rem] text-muted leading-[1.35] before:absolute before:left-0 before:top-[0.55em] before:size-1 before:bg-(--sport-color)">
                    {g.title}
                  </li>
                ))}
              </ul>
            )
          }

          <p class="mt-4 mb-0 pt-3 border-t border-dashed border-border-strong text-[0.84rem] text-muted">
            {
              sport.contact ? (
                <>
                  Spartenleitung <b class="text-base-content">{sport.contact.name}</b>
                </>
              ) : (
                <>
                  {/* Zurückhaltend: ob die Stelle vakant ist oder nur der Name fehlt,
                      wissen wir nicht – das soll nicht wie ein Mangel schreien. */}
                  Spartenleitung <span class="italic">noch nicht benannt</span>
                </>
              )
            }
          </p>
        </li>
      ))
    }
  </ul>
</div>

