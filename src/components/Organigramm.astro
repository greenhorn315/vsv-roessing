---
import Pictogram from './Pictogram.astro';
import { getSports } from '../lib/sportarten';
import { getTrainings } from '../lib/trainings';
import { sportColorVar } from '../lib/labels';
import { site } from '../lib/site';

const trainings = await getTrainings();
const zweige = (await getSports()).map(({ id, data }) => ({
  // Slug aus dem Dateinamen, alles Übrige aus den Angaben der Datei.
  sport: { ...data, slug: id },
  gruppen: trainings.filter((t) => t.sport === id),
}));
---

<div>
  <p class="mx-auto w-max max-w-full rounded-xl bg-primary px-8 py-3 text-center text-primary-content">
    <strong class="block font-display text-xl">{site.shortName}</strong>
    <span class="text-sm text-primary-content/80">{site.legalName}</span>
  </p>
  <span class="mx-auto block h-6 w-0.5 bg-base-content/20" aria-hidden="true"></span>

  <ul class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
    {
      zweige.map(({ sport, gruppen }) => (
        <li
          class="card rounded-t-none border border-t-4 border-base-300 border-t-(--sport-color) bg-base-100 p-4"
          style={`--sport-color:${sportColorVar(sport.color)}`}
        >
          <div class="flex items-center gap-3">
            <Pictogram name={sport.pictogram} size={40} class="shrink-0" />
            <div>
              <h3 class="text-lg">
                <a class="hover:underline" href={`/sportangebote/${sport.slug}/`}>{sport.name}</a>
              </h3>
              <p class="text-xs text-base-content/70">
                {gruppen.length === 0
                  ? 'noch keine Gruppen'
                  : `${gruppen.length} ${gruppen.length === 1 ? 'Gruppe' : 'Gruppen'}`}
              </p>
            </div>
          </div>

          {
            gruppen.length > 0 && (
              <ul class="mt-4 flex flex-col gap-1">
                {gruppen.map((g) => (
                  <li class="relative pl-3 text-sm leading-snug text-base-content/70 before:absolute before:top-[0.55em] before:left-0 before:size-1 before:bg-(--sport-color)">
                    {g.title}
                  </li>
                ))}
              </ul>
            )
          }

          <p class="mt-4 border-t border-dashed border-base-content/20 pt-3 text-sm text-base-content/70">
            {
              sport.contact ? (
                <>
                  Spartenleitung <b class="text-base-content">{sport.contact.name}</b>
                </>
              ) : (
                <>
                  {/* Zurückhaltend: ob die Stelle vakant ist oder nur der Name fehlt,
                      wissen wir nicht – das soll nicht wie ein Mangel schreien. */}
                  Spartenleitung <span class="italic">noch nicht benannt</span>
                </>
              )
            }
          </p>
        </li>
      ))
    }
  </ul>
</div>

