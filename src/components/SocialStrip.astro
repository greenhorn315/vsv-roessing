---
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '../lib/site';

/*
 * Vier quadratische Kacheln. Bilder dafür kommen nach src/assets/social/
 * (JPG, PNG oder WebP) und werden nach Dateinamen sortiert verwendet; bis
 * dahin zeigt jede Kachel nur den gestalteten Platzhalter – ohne Anfrage an
 * den Server.
 */
const dateien = import.meta.glob<ImageMetadata>('/src/assets/social/*.{jpg,png,webp}', {
  eager: true,
  import: 'default',
});
const bilder = Object.keys(dateien)
  .sort()
  .map((pfad) => dateien[pfad]);
const shots = [1, 2, 3, 4].map((n) => ({ n, image: bilder[n - 1] }));
---

<div>
  <div class="grid grid-cols-4 gap-3 max-[700px]:grid-cols-2">
    {
      shots.map(({ n, image }) => (
        <a
          class="block overflow-hidden rounded-box transition hover:-translate-y-1 hover:shadow-md focus-visible:-translate-y-1 focus-visible:shadow-md"
          href={site.social.instagram.url}
          rel="noopener"
          aria-label={`Beitrag ${n} auf Instagram ansehen`}
        >
          <Photo
            image={image}
            alt=""
            width={1}
            height={1}
            widths={[300, 400, 600]}
            sizes="(max-width: 700px) calc(50vw - 1.5rem), 280px"
            placeholderIcon="camera"
          />
        </a>
      ))
    }
  </div>
  <a class="btn mt-6 btn-outline btn-primary" href={site.social.instagram.url} rel="noopener">
    <Icon name="instagram" />
    {site.social.instagram.handle} folgen
  </a>
</div>
