---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../lib/site';

const dateien = import.meta.glob<ImageMetadata>('/src/assets/social/*.{jpg,png,webp}', {
  eager: true,
  import: 'default',
});
const bilder = Object.keys(dateien)
  .sort()
  .map((pfad) => dateien[pfad]);
const shots = [1, 2, 3, 4].map((n) => ({ n, image: bilder[n - 1] }));

// Picture gibt das aus layout berechnete sizes nicht an die <source>-Elemente weiter; ohne sizes nimmt der Browser 100vw.
const sizes = '(min-width: 280px) 280px, 100vw';
---

<div>
  <div class="grid grid-cols-4 gap-3 max-[700px]:grid-cols-2">
    {
      shots.map(({ n, image }) => (
        <a
          class="block overflow-hidden rounded-box transition hover:-translate-y-1 hover:shadow-md focus-visible:-translate-y-1 focus-visible:shadow-md"
          href={site.social.instagram.url}
          rel="noopener"
          aria-label={`Beitrag ${n} auf Instagram ansehen`}
        >
          {image ? (
            <Picture
              src={image}
              alt=""
              formats={['avif', 'webp']}
              layout="constrained"
              width={280}
              height={280}
              sizes={sizes}
              class="aspect-square w-full object-cover"
            />
          ) : (
            <div
              class="grid aspect-square place-content-center bg-base-300 bg-linear-135 from-primary/10 to-base-300 text-secondary"
              aria-hidden="true"
            >
              <Icon name="camera" size={30} />
            </div>
          )}
        </a>
      ))
    }
  </div>
  <a class="btn mt-6 btn-outline btn-primary" href={site.social.instagram.url} rel="noopener">
    <Icon name="instagram" />
    {site.social.instagram.handle} folgen
  </a>
</div>
