---
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '../lib/site';

/*
 * Vier quadratische Kacheln. Bilder dafür kommen nach src/assets/social/
 * (JPG, PNG oder WebP) und werden nach Dateinamen sortiert verwendet; bis
 * dahin zeigt jede Kachel nur den gestalteten Platzhalter – ohne Anfrage an
 * den Server.
 */
const dateien = import.meta.glob<ImageMetadata>('/src/assets/social/*.{jpg,png,webp}', {
  eager: true,
  import: 'default',
});
const bilder = Object.keys(dateien)
  .sort()
  .map((pfad) => dateien[pfad]);
const shots = [1, 2, 3, 4].map((n) => ({ n, image: bilder[n - 1] }));
---

<div class="social">
  <div class="social__grid">
    {
      shots.map(({ n, image }) => (
        <a
          class="social__item"
          href={site.social.instagram.url}
          rel="noopener"
          aria-label={`Beitrag ${n} auf Instagram ansehen`}
        >
          <Photo
            image={image}
            alt=""
            width={1}
            height={1}
            widths={[300, 400, 600]}
            sizes="(max-width: 700px) calc(50vw - 1.5rem), 280px"
            placeholderIcon="camera"
          />
        </a>
      ))
    }
  </div>
  <a class="btn btn-outline social__cta" href={site.social.instagram.url} rel="noopener">
    <Icon name="instagram" />
    {site.social.instagram.handle} folgen
  </a>
</div>

<style>
  .social__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
  }

  .social__item {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .social__item:hover,
  .social__item:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .social__cta {
    margin-top: var(--sp-5);
  }

  @media (max-width: 700px) {
    .social__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
