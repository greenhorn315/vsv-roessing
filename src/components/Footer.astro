---
import Icon from './Icon.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h2 class="footer-title">{site.name}</h2>
      <p>
        {site.address.venue}<br />
        {site.address.postalCode} {site.address.city}
      </p>
      <div class="footer-social">
        <a href={site.social.instagram.url} aria-label="VSV Rössing auf Instagram" rel="noopener">
          <Icon name="instagram" size={19} />
        </a>
        <a href={site.social.facebook.url} aria-label="VSV Rössing auf Facebook" rel="noopener">
          <Icon name="facebook" size={19} />
        </a>
      </div>
    </div>

    <div>
      <h2 class="footer-title">Kontakt</h2>
      <ul class="footer-links">
        <li>
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={16} />
            {site.email}
          </a>
        </li>
        <li>
          <a href="/kontakt">
            <Icon name="pin" size={16} />
            Anfahrt &amp; Karte
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="footer-title">Verein</h2>
      <ul class="footer-links">
        <li><a href="/sportangebote">Sportangebote</a></li>
        <li><a href="/mitglied-werden">Mitglied werden</a></li>
        <li><a href="/verein">Über uns</a></li>
        <li><a href="/mitglied-werden#formulare">Formulare &amp; Downloads</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} {site.name}</span>
    <nav aria-label="Rechtliches">
      <a href="/impressum">Impressum</a>
      <span aria-hidden="true">·</span>
      <a href="/datenschutz">Datenschutz</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-primary);
    color: var(--c-text-on-dark);
    padding-block: var(--sp-8) var(--sp-5);
    margin-top: var(--sp-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--sp-7);
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: #fff;
    margin: 0 0 var(--sp-4);
  }

  .site-footer p {
    font-size: 0.94rem;
    color: var(--c-text-on-dark);
    margin: 0;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-text-on-dark);
    font-size: 0.94rem;
    text-decoration: none;
    padding-block: 0.2rem;
  }
  .footer-links a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .footer-social {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }
  .footer-social a {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    display: grid;
    place-items: center;
    color: #fff;
    transition: background-color 0.16s ease;
  }
  .footer-social a:hover {
    background: var(--c-accent-ink);
  }

  .footer-bottom {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .footer-bottom a {
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
  }
  .footer-bottom a:hover {
    text-decoration: underline;
  }
  .footer-bottom nav {
    display: flex;
    gap: 0.5rem;
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
</style>
