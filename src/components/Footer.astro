---
import Icon from './Icon.astro';
import { site } from '../lib/site';

const year = new Date().getFullYear();

const heading = 'mt-0 mb-4 font-display text-[1.05rem] text-white';
const linkList = 'm-0 flex list-none flex-col gap-2 p-0';
const link =
  'inline-flex items-center gap-2 py-[0.2rem] text-[0.94rem] text-on-dark no-underline hover:text-white hover:underline';
const social =
  'grid size-11 place-items-center rounded-full bg-white/12 text-white transition-colors duration-150 hover:bg-accent';
const legalLink = 'text-white/82 no-underline hover:underline';
---

<footer class="bg-primary pt-16 pb-6 text-on-dark">
  {/* daisyUI-footer als Raster. Die Spalten ordnet es selbst als Raster mit
     Lücke an; hier bringen Überschriften ihren Abstand mit (*:gap-0). */}
  <div
    class="footer container grid-cols-[1.5fr_1fr_1fr] gap-11 text-step-0 leading-[1.6] *:gap-0 max-[800px]:grid-cols-1 max-[800px]:gap-8"
  >
    <div>
      <h2 class={heading}>{site.name}</h2>
      <p class="m-0 text-[0.94rem] text-on-dark">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}
      </p>
      <div class="mt-4 flex gap-2">
        <a class={social} href={site.social.instagram.url} aria-label="VSV Rössing auf Instagram" rel="noopener">
          <Icon name="instagram" size={19} />
        </a>
        <a class={social} href={site.social.facebook.url} aria-label="VSV Rössing auf Facebook" rel="noopener">
          <Icon name="facebook" size={19} />
        </a>
      </div>
    </div>

    <div>
      <h2 class={heading}>Kontakt</h2>
      <ul class={linkList}>
        <li>
          <a class={link} href={`mailto:${site.email}`}>
            <Icon name="mail" size={16} />
            {site.email}
          </a>
        </li>
        <li>
          <a class={link} href="/kontakt/">
            <Icon name="pin" size={16} />
            Anfahrt &amp; Karte
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class={heading}>Verein</h2>
      <ul class={linkList}>
        <li><a class={link} href="/sportangebote/">Sportangebote</a></li>
        <li><a class={link} href="/mitglied-werden/">Mitglied werden</a></li>
        <li><a class={link} href="/verein/">Über uns</a></li>
        <li><a class={link} href="/mitglied-werden/#formulare">Formulare &amp; Downloads</a></li>
      </ul>
    </div>
  </div>

  <div
    class="container mt-11 flex flex-wrap justify-between gap-3 border-t border-white/15 pt-6 text-[0.85rem] text-white/72"
  >
    <span>© {year} {site.name}</span>
    <nav class="flex gap-2" aria-label="Rechtliches">
      <a class={legalLink} href="/impressum/">Impressum</a>
      <span aria-hidden="true">·</span>
      <a class={legalLink} href="/datenschutz/">Datenschutz</a>
    </nav>
  </div>
</footer>
