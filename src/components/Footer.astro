---
import Icon from './Icon.astro';
import Container from './Container.astro';
import { site } from '../lib/site';

const year = new Date().getFullYear();

const heading = 'mb-4 text-lg text-primary-content';
const linkList = 'flex flex-col gap-2';
const link =
  'inline-flex items-center gap-2 py-1 text-primary-content/90 hover:text-primary-content hover:underline';
const social =
  'btn btn-circle border-0 bg-primary-content/10 text-primary-content hover:bg-accent';
const legalLink = 'hover:underline';
---

<footer class="bg-primary pt-16 pb-6 text-primary-content/90">
  <Container class="footer grid-cols-[1.5fr_1fr_1fr] gap-10 text-base *:gap-0 max-[800px]:grid-cols-1 max-[800px]:gap-8">
    <div>
      <h2 class={heading}>{site.name}</h2>
      <p>
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}
      </p>
      <div class="mt-4 flex gap-2">
        <a class={social} href={site.social.instagram.url} aria-label="VSV Rössing auf Instagram" rel="noopener">
          <Icon name="instagram" size={19} />
        </a>
        <a class={social} href={site.social.facebook.url} aria-label="VSV Rössing auf Facebook" rel="noopener">
          <Icon name="facebook" size={19} />
        </a>
      </div>
    </div>

    <div>
      <h2 class={heading}>Kontakt</h2>
      <ul class={linkList}>
        <li>
          <a class={link} href={`mailto:${site.email}`}>
            <Icon name="mail" size={16} />
            {site.email}
          </a>
        </li>
        <li>
          <a class={link} href="/kontakt/">
            <Icon name="pin" size={16} />
            Anfahrt &amp; Karte
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class={heading}>Verein</h2>
      <ul class={linkList}>
        <li><a class={link} href="/sportangebote/">Sportangebote</a></li>
        <li><a class={link} href="/mitglied-werden/">Mitglied werden</a></li>
        <li><a class={link} href="/verein/">Über uns</a></li>
        <li><a class={link} href="/mitglied-werden/#formulare">Formulare &amp; Downloads</a></li>
      </ul>
    </div>
  </Container>

  <Container class="mt-10 flex flex-wrap justify-between gap-3 border-t border-primary-content/15 pt-6 text-sm text-primary-content/75">
    <span>© {year} {site.name}</span>
    <nav class="flex gap-2" aria-label="Rechtliches">
      <a class={legalLink} href="/impressum/">Impressum</a>
      <span aria-hidden="true">·</span>
      <a class={legalLink} href="/datenschutz/">Datenschutz</a>
    </nav>
  </Container>
</footer>
