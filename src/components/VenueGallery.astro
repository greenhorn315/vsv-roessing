---
import Icon from './Icon.astro';
import Container from './Container.astro';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { zahlwort } from '../lib/labels';
import { nachOrder } from '../lib/reihenfolge';
import { mapsUrl } from '../lib/site';

interface Props {
  id?: string;
  title?: string;
  lead?: string;
}

const venues = (await getCollection('sportstaetten')).sort(nachOrder).map((eintrag) => eintrag.data);

const orteWort = zahlwort(venues.length, { eins: 'einen' });

const {
  id = 'sportstaetten',
  title = 'Unsere Sportstätten',
  lead = `Zwei Anschriften, ${orteWort} Orte: Sporthalle und Dorfbrunnen liegen im Loderwinkel unter einem Dach, Sportplatz, Feuerplatz und Vereinsheim gemeinsam Zum Klay.`,
} = Astro.props;

// Picture gibt das aus layout berechnete sizes nicht an die <source>-Elemente weiter; ohne sizes nimmt der Browser 100vw.
const sizes = '(min-width: 560px) 560px, 100vw';
---

<section class="py-16 md:py-20" id={id}>
  <Container>
    <header class="mb-8 max-w-[52ch]">
      <h2 class="text-3xl md:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-base-content/70">{lead}</p>
    </header>

    <ul class="grid grid-cols-2 items-start gap-5 md:gap-8 max-[700px]:grid-cols-1">
      {
        venues.map((ort) => (
          <li class="card overflow-hidden rounded-3xl bg-base-100 shadow-sm">
            {ort.photos?.[0] && (
              <Picture
                src={ort.photos[0].src}
                alt={ort.photos[0].alt}
                formats={['avif', 'webp']}
                layout="constrained"
                width={560}
                sizes={sizes}
                class="aspect-4/3 w-full object-cover"
              />
            )}
            {ort.photos && ort.photos.length > 1 && (
              <ul class="grid grid-cols-[repeat(auto-fit,minmax(0,1fr))] gap-2.5 px-2.5 pt-2.5">
                {ort.photos.slice(1).map((bild) => (
                  <li class="flex flex-col gap-1">
                    <Picture
                      src={bild.src}
                      alt={bild.alt}
                      formats={['avif', 'webp']}
                      layout="constrained"
                      width={560}
                      sizes={sizes}
                      class="aspect-4/3 w-full rounded-xl object-cover"
                    />
                    {bild.caption && <span class="text-center text-xs text-base-content/70">{bild.caption}</span>}
                  </li>
                ))}
              </ul>
            )}
            <div class="card-body gap-0 p-5 text-base md:p-6">
              <h3 class="text-xl">{ort.name}</h3>
              {ort.alias && <p class="mt-0.5 text-sm text-base-content/70">auch {ort.alias}</p>}
              {ort.street && (
                <p class="mt-2.5 flex items-center gap-1.5 text-sm">
                  <Icon name="pin" size={16} class="flex-none text-secondary" />
                  <a class="link" href={mapsUrl(ort)} target="_blank" rel="noopener">
                    {ort.street}, {ort.postalCode} {ort.city}
                  </a>
                </p>
              )}
              <p class="mt-2.5 text-sm text-base-content/70">{ort.note}</p>
              {ort.facilities && <p class="mt-2.5 text-sm text-base-content/70">{ort.facilities}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

