---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { getCollection } from 'astro:content';
import { zahlwort } from '../lib/labels';
import { nachOrder } from '../lib/reihenfolge';

interface Props {
  id?: string;
  title?: string;
  lead?: string;
}

// Orte und Reihenfolge in src/content/sportstaetten.yaml.
const venues = (await getCollection('sportstaetten')).sort(nachOrder).map((eintrag) => eintrag.data);

/** Kleine Zahlen ausschreiben – im Fließtext lesen sie sich besser. Akkusativ: „einen Ort“. */
const orteWort = zahlwort(venues.length, { eins: 'einen' });

const {
  id = 'sportstaetten',
  title = 'Unsere Sportstätten',
  lead = `Zwei Anschriften, ${orteWort} Orte: Sporthalle und Dorfbrunnen liegen im Loderwinkel unter einem Dach, Sportplatz, Feuerplatz und Vereinsheim gemeinsam Zum Klay.`,
} = Astro.props;

/*
 * Bildbreiten. Die Kacheln stehen ab 700 px zweispaltig im 1180-px-Container
 * (höchstens rund 560 px breit), darunter einspaltig über die volle Breite.
 * Die weiteren Ansichten teilen sich die Kachelbreite abzüglich des Rands;
 * steht nur eine da, ist sie so breit wie die Kachel.
 */
const kachelBreiten = [360, 560, 800, 1024];
const kachelSizes = '(max-width: 700px) calc(100vw - 2rem), (max-width: 1220px) calc(50vw - 3rem), 560px';
const kleinBreiten = [280, 400, 560, 800, 1024];
const kleinSizes = (anzahl: number) =>
  `(max-width: 700px) calc((100vw - 3.2rem) / ${anzahl}), (max-width: 1220px) calc((50vw - 4.2rem) / ${anzahl}), calc(540px / ${anzahl})`;

/** Karten-Link auf die Anschrift, damit Navigation direkt startet. */
const mapsUrl = (ort: (typeof venues)[number]) =>
  `https://www.openstreetmap.org/search?query=${encodeURIComponent(
    [ort.street, ort.postalCode, ort.city].filter(Boolean).join(' ')
  )}`;
---

<section class="section" id={id}>
  <div class="container">
    <header class="max-w-[52ch] mb-8">
      <h2>{title}</h2>
      <p class="lead">{lead}</p>
    </header>

    <ul class="list-none m-0 p-0 grid grid-cols-2 gap-[clamp(1.25rem,3vw,2rem)] items-start max-[700px]:grid-cols-1">
      {
        venues.map((ort) => (
          <li class="card bg-base-100 rounded-lg overflow-hidden shadow-sm">
            {/* Photo rundet seine Ecken im eigenen (ungeschichteten) CSS ab –
                deshalb die Radien hier mit ! (important): oben ohne Rundung,
                weil die Karte schon abschneidet, die kleinen Ansichten mit 10px. */}
            <Photo
              image={ort.photos?.[0]?.src}
              alt={ort.photos?.[0]?.alt}
              width={4}
              height={3}
              widths={kachelBreiten}
              sizes={kachelSizes}
              placeholderIcon="camera"
              placeholderText="Foto folgt"
              class="rounded-none!"
            />
            {ort.photos && ort.photos.length > 1 && (
              <ul class="list-none m-0 pt-[0.6rem] px-[0.6rem] pb-0 grid grid-cols-[repeat(auto-fit,minmax(0,1fr))] gap-[0.6rem]">
                {ort.photos.slice(1).map((bild) => (
                  <li class="flex flex-col gap-[0.3rem]">
                    <Photo
                      image={bild.src}
                      alt={bild.alt}
                      width={4}
                      height={3}
                      widths={kleinBreiten}
                      sizes={kleinSizes(ort.photos!.length - 1)}
                      placeholderIcon="camera"
                      class="rounded-sm!"
                    />
                    {bild.caption && <span class="text-[0.78rem] text-muted text-center">{bild.caption}</span>}
                  </li>
                ))}
              </ul>
            )}
            <div class="card-body gap-0 p-[clamp(1.1rem,2.5vw,1.6rem)] text-step-0">
              <h3 class="m-0 text-[1.15rem]">{ort.name}</h3>
              {ort.alias && <p class="mt-[0.15rem] mb-0 text-[0.85rem] text-muted">auch {ort.alias}</p>}
              {ort.street && (
                <p class="flex items-center gap-[0.4rem] mt-[0.6rem] mb-0 text-[0.92rem]">
                  <Icon name="pin" size={16} class="flex-none text-secondary" />
                  <a href={mapsUrl(ort)} target="_blank" rel="noopener">
                    {ort.street}, {ort.postalCode} {ort.city}
                  </a>
                </p>
              )}
              <p class="mt-[0.6rem] mb-0 text-[0.92rem] text-muted">{ort.note}</p>
              {ort.facilities && <p class="mt-[0.6rem] mb-0 text-[0.92rem] text-muted">{ort.facilities}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

