---
import Icon from './Icon.astro';
import {
  getTrainings,
  trainingsByDay,
  trainingsOfSport,
  type Training,
} from '../lib/trainings';
import { seasonLabels, type Weekday } from '../lib/labels';

interface Props {
  /** Nur die Trainings dieser Sportart (Dateiname in src/content/sportarten/). */
  sport?: string;
  /** Höchstens so viele Einträge zeigen. */
  limit?: number;
  /** Nach Wochentagen gruppieren statt einer durchgehenden Liste. */
  grouped?: boolean;
}

const { sport, limit, grouped = false } = Astro.props;

const wochentagNamen: Record<Weekday, string> = {
  Mo: 'Montag',
  Di: 'Dienstag',
  Mi: 'Mittwoch',
  Do: 'Donnerstag',
  Fr: 'Freitag',
  Sa: 'Samstag',
  So: 'Sonntag',
};

const auswahl = sport ? await trainingsOfSport(sport) : await getTrainings();
const sichtbar = limit ? auswahl.slice(0, limit) : auswahl;

// Gruppiert wird nur ohne Sportart- und Anzahl-Filter, sonst zeigt die Liste
// Tagesüberschriften über einem Ausschnitt.
const gruppen: { day: Weekday | null; entries: Training[] }[] =
  grouped && !sport && !limit
    ? await trainingsByDay()
    : [{ day: null, entries: sichtbar }];

// Zusatzzeilen unter dem Namen (Zielgruppe, Übungsleitung, Ort …)
const klein = 'text-[0.8rem] text-muted font-normal';
---

<div class="flex flex-col gap-6">
  {
    gruppen.map((gruppe) => (
      <section>
        {gruppe.day && <h3 class="text-[1rem] m-0 mb-[0.6rem]">{wochentagNamen[gruppe.day]}</h3>}
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.6rem]">
          {gruppe.entries.map((training) => (
            <li class="flex justify-between items-center gap-3 py-[0.85rem] px-4 bg-base-100 border border-border rounded-sm">
              <span class="flex flex-col font-medium leading-[1.3]">
                {training.title}
                {training.audience && <small class={klein}>{training.audience}</small>}
                {training.trainers && training.trainers.length > 0 && (
                  <small class={klein}>Übungsleitung: {training.trainers.join(', ')}</small>
                )}
                {/* Halbjahres-Hinweis, damit eine Wintergruppe im Sommer nicht
                    unkommentiert im Wochenplan steht. */}
                {training.season && (
                  <small class="inline-block mt-[0.2rem] py-[0.1rem] px-2 rounded-full bg-base-300 text-primary text-[0.74rem] font-semibold tracking-[0.03em]">
                    {seasonLabels[training.season]}
                  </small>
                )}
                {training.note && <small class:list={[klein, 'italic']}>{training.note}</small>}
                {training.place && <small class={klein}>{training.place}</small>}
              </span>
              {/* Dunkles Braun auf Gelb: 8,4:1 Kontrast. */}
              <span class="badge badge-warning h-auto border-0 rounded-full gap-[0.35rem] py-[0.3rem] px-[0.7rem] text-[0.82rem] font-bold text-[#4A3600] whitespace-nowrap">
                <Icon name="clock" size={14} />
                {gruppe.day ? training.time : `${training.day} ${training.time}`}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
