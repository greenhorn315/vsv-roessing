---
import Icon from './Icon.astro';
import { trainings } from '../data/trainings';
---

<ul class="trainings">
  {
    trainings.map((training) => (
      <li>
        <span class="trainings__name">
          {training.title}
          {training.place && <small>{training.place}</small>}
        </span>
        <span class="trainings__time">
          <Icon name="clock" size={14} />
          {training.day} {training.time}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .trainings {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .trainings li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    padding: 0.85rem 1rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
  }
  .trainings__name {
    display: flex;
    flex-direction: column;
    font-weight: 500;
    line-height: 1.3;
  }
  .trainings__name small {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    font-weight: 400;
  }
  .trainings__time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--c-sun);
    /* Dunkles Braun auf Gelb: 8,4:1 Kontrast. */
    color: #4A3600;
    white-space: nowrap;
  }
</style>
