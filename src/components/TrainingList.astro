---
import Icon from './Icon.astro';
import {
  trainings,
  trainingsByDay,
  trainingsOfSport,
  type Training,
  type Weekday,
} from '../data/trainings';

interface Props {
  /** Nur die Trainings dieser Sparte (slug aus sports.ts). */
  sport?: string;
  /** Höchstens so viele Einträge zeigen. */
  limit?: number;
  /** Nach Wochentagen gruppieren statt einer durchgehenden Liste. */
  grouped?: boolean;
}

const { sport, limit, grouped = false } = Astro.props;

const wochentagNamen: Record<Weekday, string> = {
  Mo: 'Montag',
  Di: 'Dienstag',
  Mi: 'Mittwoch',
  Do: 'Donnerstag',
  Fr: 'Freitag',
  Sa: 'Samstag',
  So: 'Sonntag',
};

const auswahl = sport ? trainingsOfSport(sport) : trainings;
const sichtbar = limit ? auswahl.slice(0, limit) : auswahl;

// Gruppiert wird nur ohne Sparten- und Anzahl-Filter, sonst zeigt die Liste
// Tagesüberschriften über einem Ausschnitt.
const gruppen: { day: Weekday | null; entries: Training[] }[] =
  grouped && !sport && !limit
    ? trainingsByDay()
    : [{ day: null, entries: sichtbar }];
---

<div class="trainings">
  {
    gruppen.map((gruppe) => (
      <section class="trainings__group">
        {gruppe.day && <h3 class="trainings__day">{wochentagNamen[gruppe.day]}</h3>}
        <ul class="trainings__list">
          {gruppe.entries.map((training) => (
            <li>
              <span class="trainings__name">
                {training.title}
                {training.audience && <small>{training.audience}</small>}
                {training.trainers && training.trainers.length > 0 && (
                  <small>Übungsleitung: {training.trainers.join(', ')}</small>
                )}
                {training.note && <small class="trainings__note">{training.note}</small>}
                {training.place && <small>{training.place}</small>}
              </span>
              <span class="trainings__time">
                <Icon name="clock" size={14} />
                {gruppe.day ? training.time : `${training.day} ${training.time}`}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .trainings {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .trainings__day {
    font-size: 1rem;
    margin: 0 0 0.6rem;
  }
  .trainings__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .trainings__list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    padding: 0.85rem 1rem;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
  }
  .trainings__name {
    display: flex;
    flex-direction: column;
    font-weight: 500;
    line-height: 1.3;
  }
  .trainings__name small {
    font-size: 0.8rem;
    color: var(--c-text-muted);
    font-weight: 400;
  }
  .trainings__note {
    font-style: italic;
  }
  .trainings__time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--c-sun);
    /* Dunkles Braun auf Gelb: 8,4:1 Kontrast. */
    color: #4A3600;
    white-space: nowrap;
  }
</style>
