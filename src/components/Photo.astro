---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  /**
   * Importiertes Bild aus src/assets/ (etwa über image() in einer Content
   * Collection). Ohne Bild zeigt die Komponente nur den gestalteten
   * Platzhalter – und stellt keine Anfrage an den Server.
   */
  image?: ImageMetadata;
  alt?: string;
  /**
   * Seitenverhältnis der Kachel, z. B. 4 und 3. Das Foto füllt sie per
   * object-fit: cover; width/height am <img> kommen aus der Bilddatei.
   */
  width: number;
  height: number;
  /** Breiten der erzeugten Varianten in px; größere als das Original entfallen. */
  widths?: number[];
  /** Angezeigte Breite je Viewport, wie im sizes-Attribut. */
  sizes?: string;
  /** Erstes Bild im Viewport eifrig laden, alle anderen lazy. */
  eager?: boolean;
  /** Icon des Platzhalters, solange das Foto noch fehlt. */
  placeholderIcon?: IconName;
  placeholderText?: string;
  class?: string;
}

const {
  image,
  alt = '',
  width,
  height,
  widths = [400, 800],
  sizes = '100vw',
  eager = false,
  placeholderIcon = 'sparkle',
  placeholderText,
  class: className = 'rounded-box',
} = Astro.props;
---

<!--
  Fotos liegen unter src/assets/ und laufen durch Astros Bildverarbeitung:
  AVIF und WebP mit JPEG als Rückfall, je mehrere Breiten. Fehlt ein Foto
  noch ganz, bleibt der gestaltete Platzhalter stehen.
-->
<div
  class:list={['relative isolate aspect-(--photo-ratio) overflow-hidden bg-base-300', className]}
  style={`--photo-ratio:${width} / ${height}`}
>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={widths.filter((w) => w <= image.width)}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
        class="absolute inset-0 w-full h-full object-cover"
      />
    ) : (
      <div
        class="absolute inset-0 grid place-content-center justify-items-center gap-2 bg-linear-135 from-primary/10 to-base-300 p-4 text-center text-secondary"
        aria-hidden="true"
      >
        <Icon name={placeholderIcon} size={30} />
        {placeholderText && (
          <span class="text-xs font-semibold tracking-wide uppercase opacity-75">
            {placeholderText}
          </span>
        )}
      </div>
    )
  }
</div>
