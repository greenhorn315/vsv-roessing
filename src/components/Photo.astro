---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  /**
   * Importiertes Bild aus src/assets/ (etwa über image() in einer Content
   * Collection). Ohne Bild zeigt die Komponente nur den gestalteten
   * Platzhalter – und stellt keine Anfrage an den Server.
   */
  image?: ImageMetadata;
  alt?: string;
  /**
   * Seitenverhältnis der Kachel, z. B. 4 und 3. Das Foto füllt sie per
   * object-fit: cover; width/height am <img> kommen aus der Bilddatei.
   */
  width: number;
  height: number;
  /** Breiten der erzeugten Varianten in px; größere als das Original entfallen. */
  widths?: number[];
  /** Angezeigte Breite je Viewport, wie im sizes-Attribut. */
  sizes?: string;
  /** Erstes Bild im Viewport eifrig laden, alle anderen lazy. */
  eager?: boolean;
  /** Icon des Platzhalters, solange das Foto noch fehlt. */
  placeholderIcon?: IconName;
  placeholderText?: string;
  class?: string;
}

const {
  image,
  alt = '',
  width,
  height,
  widths = [400, 800],
  sizes = '100vw',
  eager = false,
  placeholderIcon = 'sparkle',
  placeholderText,
  class: className,
} = Astro.props;
---

<!--
  Fotos liegen unter src/assets/ und laufen durch Astros Bildverarbeitung:
  AVIF und WebP mit JPEG als Rückfall, je mehrere Breiten. Fehlt ein Foto
  noch ganz, bleibt der gestaltete Platzhalter stehen.
-->
<div
  class:list={['photo', className]}
  style={`--photo-ratio:${width} / ${height}`}
>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={widths.filter((w) => w <= image.width)}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="photo__placeholder" aria-hidden="true">
        <Icon name={placeholderIcon} size={30} />
        {placeholderText && <span>{placeholderText}</span>}
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--photo-ratio);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--c-tint-green);
    isolation: isolate;
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-2);
    padding: var(--sp-4);
    text-align: center;
    color: var(--c-primary-light);
    background: linear-gradient(135deg, var(--c-tint-green), var(--c-surface-sunken));
  }
  .photo__placeholder span {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
