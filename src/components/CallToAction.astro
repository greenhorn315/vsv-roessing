---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Erstmal reinschnuppern statt gleich unterschreiben?',
  text = 'Komm einfach zu einem Training vorbei – unverbindlich, kostenlos, jederzeit.',
} = Astro.props;
---

<section class="bg-primary text-white py-[clamp(2.5rem,5vw,4rem)] reveal">
  <div class="container flex items-center justify-between flex-wrap gap-8">
    <div>
      <h2 class="text-white max-w-[22ch] mb-2">{title}</h2>
      <p class="text-white/85 m-0 max-w-[46ch]">{text}</p>
    </div>
    <div class="flex gap-3 flex-wrap">
      <a class="btn btn-on-dark" href="/kontakt/#probetraining">
        <Icon name="sport" />
        Probetraining anfragen
      </a>
      {/* Weiße Kontur auf Grün – btn-outline ist für hellen Grund gedacht. */}
      <a
        class="btn bg-transparent text-white border-white/45 hover:bg-white/12 hover:border-white"
        href="/sportangebote/"
      >
        Sportarten ansehen
      </a>
    </div>
  </div>
</section>
