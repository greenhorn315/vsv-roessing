---
import Icon from './Icon.astro';
import Container from './Container.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Erstmal reinschnuppern statt gleich unterschreiben?',
  text = 'Komm einfach zu einem Training vorbei – unverbindlich, kostenlos, jederzeit.',
} = Astro.props;
---

<section class="bg-primary py-10 text-primary-content md:py-16">
  <Container class="flex flex-wrap items-center justify-between gap-8">
    <div>
      <h2 class="mb-2 max-w-[22ch] text-3xl text-primary-content md:text-4xl">{title}</h2>
      <p class="max-w-[46ch] text-primary-content/85">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-lg btn-warning" href="/kontakt/#probetraining">
        <Icon name="sport" />
        Probetraining anfragen
      </a>
      <a class="btn btn-lg btn-secondary" href="/sportangebote/">Sportarten ansehen</a>
    </div>
  </Container>
</section>
