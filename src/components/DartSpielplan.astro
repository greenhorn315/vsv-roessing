---
import Spielplan from './Spielplan.astro';
import { dartSaison, kommendeDartSpiele } from '../data/dartSpielplan';

const spiele = kommendeDartSpiele();
const heimspiele = spiele.filter((spiel) => spiel.home).length;

const lead =
  'Drei Mannschaften, jede mit Hin- und Rückrunde gegen dieselben Gegner.' +
  ` ${spiele.length} Partien stehen noch an, davon ${heimspiele} zu Hause im Dorfbrunnen.` +
  ' Gespielte Begegnungen fallen aus der Liste heraus.';
---

<Spielplan
  heading={`Ligaspiele ${dartSaison}`}
  caption={`Kommende Dart-Partien der Saison ${dartSaison}`}
  spiele={spiele}
  withTeam
>
  {lead}
</Spielplan>
