---
import {
  dartDatum,
  dartSaison,
  kommendeDartSpiele,
} from '../data/dartSpielplan';

const spiele = kommendeDartSpiele();
const heimspiele = spiele.filter((spiel) => spiel.home).length;
---

{
  spiele.length > 0 && (
    <section class="section--tight">
      <div class="container narrow">
        <div class="section-head">
          <h2>Spielplan {dartSaison}</h2>
          <p>
            {spiele.length} Partien stehen noch an, davon {heimspiele} zu Hause
            im Dorfbrunnen. Gespielte Begegnungen fallen aus der Liste heraus.
          </p>
        </div>

        <div class="spielplan">
          <table>
            <caption class="visually-hidden">
              Kommende Dart-Partien der Saison {dartSaison}
            </caption>
            <thead>
              <tr>
                <th scope="col">Datum</th>
                <th scope="col">Zeit</th>
                <th scope="col">Team</th>
                <th scope="col">Gegner</th>
                <th scope="col">Wo</th>
              </tr>
            </thead>
            <tbody>
              {spiele.map((spiel) => (
                <tr>
                  <td class="spielplan__datum">{dartDatum(spiel.date)}</td>
                  <td class="spielplan__zeit">{spiel.time}</td>
                  <td>{spiel.team}</td>
                  <td>{spiel.opponent}</td>
                  <td>
                    <span
                      class:list={[
                        'spielplan__ort',
                        spiel.home && 'spielplan__ort--heim',
                      ]}
                    >
                      {spiel.home ? 'Heim' : 'Auswärts'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )
}

<style>
  .spielplan {
    overflow-x: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-surface);
  }
  table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  caption.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  th {
    text-align: left;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-text-muted);
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--c-border);
  }
  td {
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }
  tbody tr:last-child td {
    border-bottom: none;
  }
  .spielplan__datum,
  .spielplan__zeit {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .spielplan__ort {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
    white-space: nowrap;
  }
  .spielplan__ort--heim {
    background: var(--c-sun);
    border-color: transparent;
    /* Dunkles Braun auf Gelb: 8,4:1 Kontrast. */
    color: #4a3600;
  }
</style>
