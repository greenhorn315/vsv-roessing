---
/**
 * Rahmen für Rechtstexte (Impressum, Datenschutzerklärung). Der Text selbst
 * kommt als gerendertes Markdown aus src/content/rechtliches/ in den Slot;
 * Links auf E-Mail-Adressen, Web-Adressen und Telefonnummern stehen dort
 * ausdrücklich im Markdown.
 *
 * Die Stile greifen mit :global(), weil gerendertes Markdown nicht die
 * Kennung trägt, mit der Astro die Stile einer Komponente eingrenzt. Die
 * Klasse .legal-content davor hält sie trotzdem auf diesen Rahmen beschränkt.
 */
---

<div class="legal-content">
  <slot />
</div>

<style>
  .legal-content {
    max-width: 720px;
  }
  .legal-content :global(h2) {
    font-size: var(--step-1);
    margin-top: var(--sp-6);
  }
  .legal-content :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-content :global(h3) {
    font-size: 1.02rem;
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-2);
  }
  .legal-content :global(p) {
    color: var(--c-text-muted);
    font-size: 0.96rem;
  }
  .legal-content :global(a) {
    color: var(--c-accent-ink);
    /* Lange URLs dürfen den Textfluss nicht sprengen. */
    overflow-wrap: anywhere;
  }
</style>
