---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  /** Größe in px (Breite = Höhe). Standard: erbt die Schriftgröße. */
  size?: number | string;
  /**
   * Barrierefreiheit: Icons ohne `label` sind dekorativ und werden
   * von Screenreadern übersprungen. Mit `label` werden sie zum Bild
   * mit Textalternative.
   */
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size, label, class: className, strokeWidth = 1.75 } = Astro.props;
const dim = size ? (typeof size === 'number' ? `${size}px` : size) : undefined;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  style={dim ? `width:${dim};height:${dim}` : undefined}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>

<style>
  .icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }
</style>
