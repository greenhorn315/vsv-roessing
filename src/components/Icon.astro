---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  /**
   * Größe in px (Breite = Höhe). Standard: 1em, also die Schriftgröße.
   * Steht als Inline-Stil am Element, damit keine Klasse sie verändert
   * (z. B. `.btn svg`). Größe deshalb über `size` setzen, nicht per Klasse.
   */
  size?: number | string;
  /**
   * Barrierefreiheit: Icons ohne `label` sind dekorativ und werden
   * von Screenreadern übersprungen. Mit `label` werden sie zum Bild
   * mit Textalternative.
   */
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size, label, class: className, strokeWidth = 1.75 } = Astro.props;
const dim = size ? (typeof size === 'number' ? `${size}px` : size) : '1em';
---

<svg
  class:list={['icon shrink-0', className]}
  viewBox="0 0 24 24"
  style={`width:${dim};height:${dim}`}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>
