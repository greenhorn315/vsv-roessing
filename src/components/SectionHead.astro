---
interface Props {
  eyebrow?: string;
  title: string;
  class?: string;
}

const { eyebrow, title, class: className = 'mb-10' } = Astro.props;
---

<div class:list={['max-w-2xl', className]}>
  {eyebrow && <p class="mb-3 text-sm font-bold uppercase tracking-wider text-accent">{eyebrow}</p>}
  <h2 class="text-3xl md:text-4xl">{title}</h2>
  {
    Astro.slots.has('default') && (
      <div class="mt-3 space-y-2 text-lg text-base-content/70">
        <slot />
      </div>
    )
  }
</div>
