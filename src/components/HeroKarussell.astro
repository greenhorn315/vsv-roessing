---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import { nachOrder } from '../lib/reihenfolge';

interface Props {
  class?: string;
}

const bilder = (await getCollection('karussell')).sort(nachOrder).map((eintrag) => eintrag.data);
const dauer = 6000;
const { class: className } = Astro.props;

// Nur das erste Bild eager: die übrigen liegen außerhalb des Containers und laden erst beim Blättern.
const widths = [400, 560, 800];
const sizes = '(max-width: 940px) min(calc(100vw - 2rem), 520px), 560px';
---

<div
  class:list={['relative isolate overflow-hidden bg-base-300', className]}
  data-karussell
  data-dauer={dauer}
  role="group"
  aria-roledescription="Karussell"
  aria-label="Eindrücke aus dem Vereinsleben"
>
  <ul class="carousel absolute inset-0" data-karussell-bilder>
    {
      bilder.map((bild, i) => (
        <li
          class="carousel-item relative w-full h-full"
          data-slide={i}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <Picture
            src={bild.src}
            alt={bild.alt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={widths}
            sizes={sizes}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 0 ? 'high' : undefined}
            class="w-full h-full object-cover"
            pictureAttributes={{ class: 'contents' }}
          />
          <p class="absolute inset-x-0 bottom-0 bg-linear-to-t from-neutral/85 to-neutral/0 px-4 pt-10 pb-8 text-sm font-semibold text-neutral-content text-shadow-sm">
            {bild.caption}
            {bild.credit && (
              <small class="block text-xs font-normal opacity-80">{bild.credit}</small>
            )}
          </p>
        </li>
      ))
    }
  </ul>

  <p class="sr-only" aria-live="polite" data-karussell-status></p>

  <div
    class="absolute inset-x-0 bottom-3 z-1 flex justify-center gap-2"
    hidden
    data-karussell-punkte
  >
    {
      bilder.map((bild, i) => (
        <button
          type="button"
          class:list={[
            'relative size-2.5 cursor-pointer rounded-full',
            'bg-white/50 ring-1 ring-neutral/35 hover:bg-white/80',
            'aria-[current=true]:bg-white aria-[current=true]:scale-130',
            'transition-[background-color,scale] duration-200 motion-reduce:transition-none',
            'focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-3',
            // Größere Trefferfläche für Finger, ohne den Punkt zu vergrößern.
            'before:absolute before:-inset-x-1 before:-inset-y-3',
          ]}
          data-zu={i}
          aria-current={i === 0 ? 'true' : undefined}
        >
          <span class="sr-only">{`Bild ${i + 1}: ${bild.caption}`}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  const karussell = document.querySelector<HTMLElement>('[data-karussell]');
  const leiste = karussell?.querySelector<HTMLElement>('[data-karussell-bilder]');

  if (karussell && leiste) {
    const bilder = [...leiste.querySelectorAll<HTMLElement>('[data-slide]')];
    const punkteLeiste = karussell.querySelector<HTMLElement>('[data-karussell-punkte]');
    const punkte = [...karussell.querySelectorAll<HTMLButtonElement>('[data-zu]')];
    const status = karussell.querySelector<HTMLElement>('[data-karussell-status]');
    const dauer = Number(karussell.dataset.dauer ?? 6000);
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    let aktuell = 0;
    let timer: number | undefined;
    let pausiert = false;

    const gehe = (index: number) => {
      const ziel = bilder[(index + bilder.length) % bilder.length];
      if (!ziel) return;
      leiste.scrollTo({ left: ziel.offsetLeft, behavior: ruhig.matches ? 'instant' : 'smooth' });
    };

    const stoppen = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
    };

    const planen = () => {
      stoppen();
      if (pausiert || document.hidden || ruhig.matches) return;
      timer = window.setTimeout(() => gehe(aktuell + 1), dauer);
    };

    const markiere = (index: number) => {
      if (index === aktuell) return;
      aktuell = index;
      bilder.forEach((bild, i) => {
        if (i === aktuell) bild.removeAttribute('aria-hidden');
        else bild.setAttribute('aria-hidden', 'true');
      });
      punkte.forEach((punkt, i) => {
        if (i === aktuell) punkt.setAttribute('aria-current', 'true');
        else punkt.removeAttribute('aria-current');
      });
      if (status) status.textContent = `Bild ${aktuell + 1} von ${bilder.length}`;
      planen();
    };

    const beobachter = new IntersectionObserver(
      (eintraege) => {
        for (const eintrag of eintraege) {
          if (eintrag.intersectionRatio >= 0.6) markiere(bilder.indexOf(eintrag.target as HTMLElement));
        }
      },
      { root: leiste, threshold: 0.6 },
    );
    bilder.forEach((bild) => beobachter.observe(bild));

    punkteLeiste?.removeAttribute('hidden');
    punkte.forEach((punkt) =>
      punkt.addEventListener('click', () => gehe(Number(punkt.dataset.zu))),
    );

    const pause = (an: boolean) => () => {
      pausiert = an;
      planen();
    };
    karussell.addEventListener('mouseenter', pause(true));
    karussell.addEventListener('mouseleave', pause(false));
    karussell.addEventListener('focusin', pause(true));
    karussell.addEventListener('focusout', pause(false));
    document.addEventListener('visibilitychange', planen);
    ruhig.addEventListener('change', planen);

    planen();
  }
</script>
