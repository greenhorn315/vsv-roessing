---
import Container from './Container.astro';
import { getFacts } from '../lib/site';

const facts = await getFacts();
---

<section class="mt-16 bg-primary py-8 text-primary-content md:mt-20" aria-label="Der Verein in Zahlen">
  <Container>
    <dl
      class="stats grid grid-flow-row grid-cols-4 gap-6 overflow-visible rounded-none max-[720px]:grid-cols-2 max-[720px]:gap-x-3 max-[720px]:gap-y-4"
    >
      {
        facts.map((fact) => (
          <div class="stat flex flex-col-reverse gap-0.5 border-0 border-e border-primary-content/20 p-0 pe-6 last:border-e-0 max-[720px]:even:border-e-0">
            <dt class="stat-title text-sm whitespace-normal text-primary-content/80">{fact.label}</dt>
            <dd class="stat-value font-display text-3xl font-semibold whitespace-normal md:text-4xl">
              {fact.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>
