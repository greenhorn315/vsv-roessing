---
import { getVereinsZahlen } from '../lib/trainings';
import { getSportCount } from '../lib/sportarten';

const vereinsZahlen = await getVereinsZahlen();
const sportCount = await getSportCount();

const zahlen = [
  { wert: String(sportCount), text: 'Sportarten' },
  { wert: String(vereinsZahlen.gruppen), text: 'Trainingsgruppen' },
  { wert: String(vereinsZahlen.uebungsleitungen), text: 'Übungsleitungen' },
  { wert: String(vereinsZahlen.kinderangebote), text: 'Angebote für Kinder' },
  { wert: String(vereinsZahlen.trainingstage), text: 'Trainingstage pro Woche' },
  // Offene Übungsleitungen nur nennen, solange es welche gibt. „0 Gruppen ohne
  // Übungsleitung“ wäre zwar eine gute Nachricht, liest sich als Kachel aber
  // wie ein Mangel. Sachlich formuliert: Ob eine Stelle vakant ist oder nur
  // der Name fehlt, ist von außen nicht zu unterscheiden.
  ...(vereinsZahlen.ohneLeitung > 0
    ? [
        {
          wert: String(vereinsZahlen.ohneLeitung),
          text: `${vereinsZahlen.ohneLeitung === 1 ? 'Gruppe' : 'Gruppen'} ohne Übungsleitung`,
        },
      ]
    : []),
];
---

{/* daisyUI-stats als Kachelraster: Die 1px-Lücken zwischen den Kacheln
    zeigen den Hintergrund in Rahmenfarbe und wirken so als Trennlinien. */}
<dl class="stats grid grid-flow-row grid-cols-3 max-[720px]:grid-cols-2 gap-px bg-border border border-border rounded-box overflow-hidden m-0">
  {
    zahlen.map((z) => (
      /* Zahl optisch zuerst, semantisch bleibt das Label vorn. */
      <div class="stat flex flex-col bg-base-100 p-6 border-0">
        <dd class="stat-value m-0 font-display text-[clamp(1.9rem,1.4rem+1.8vw,2.6rem)] font-semibold leading-none text-primary whitespace-normal">
          {z.wert}
        </dd>
        <dt class="stat-title mt-[0.35rem] text-[0.9rem] text-muted whitespace-normal">{z.text}</dt>
      </div>
    ))
  }
</dl>

