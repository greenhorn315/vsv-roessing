---
import { vereinsZahlen } from '../data/trainings';
import { sportCount } from '../data/sports';

const zahlen = [
  { wert: String(sportCount), text: 'Sparten' },
  { wert: String(vereinsZahlen.gruppen), text: 'Trainingsgruppen' },
  { wert: String(vereinsZahlen.uebungsleitungen), text: 'Übungsleitungen' },
  { wert: String(vereinsZahlen.kinderangebote), text: 'Angebote für Kinder' },
  { wert: String(vereinsZahlen.trainingstage), text: 'Trainingstage pro Woche' },
    // Sachlich: In der Liste von 2022 fehlt der Name. Ob die Stelle vakant ist
  // oder nur die Angabe, ist offen – deshalb kein „sucht Verstärkung“.
  { wert: String(vereinsZahlen.ohneLeitung), text: 'Gruppen ohne Übungsleitung' },
];
---

<dl class="zahlen">
  {
    zahlen.map((z) => (
      <div class="zahl">
        <dd>{z.wert}</dd>
        <dt>{z.text}</dt>
      </div>
    ))
  }
</dl>

<style>
  .zahlen {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
    margin: 0;
  }

  .zahl {
    background: var(--c-surface);
    padding: var(--sp-5);
    /* Zahl optisch zuerst, semantisch bleibt das Label vorn. */
    display: flex;
    flex-direction: column;
  }

  .zahl dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--c-primary);
  }

  .zahl dt {
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--c-text-muted);
  }

  @media (max-width: 720px) {
    .zahlen {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
