---
import { audienceLabels, sportColorVar, type AudienceKey } from '../lib/labels';
import { trainingsFuer } from '../lib/trainings';
import { getSports } from '../lib/sportarten';

const reihenfolge: AudienceKey[] = ['kinder', 'jugend', 'frauen', 'maenner', 'alle'];
const sports = await getSports();

/** Sportart zu einer Gruppe finden, für die Farbmarkierung. */
const farbe = (slug?: string) => {
  const sport = sports.find((s) => s.id === slug);
  return sport ? sportColorVar(sport.data.color) : 'var(--color-primary)';
};

const spalten = await Promise.all(
  reihenfolge.map(async (key) => ({
    key,
    titel: audienceLabels[key],
    gruppen: await trainingsFuer(key),
  })),
);
---

{/* Fünf Einstiege nebeneinander, solange die Breite reicht. */}
<div class="grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-x-4 gap-y-8 items-start">
  {
    spalten.map((spalte) => (
      <section>
        <h3 class="text-step-1 m-0 pb-[0.4rem] border-b-2 border-primary">{spalte.titel}</h3>
        <p class="mt-2 mb-3 mx-0 text-[0.8rem] tracking-[0.05em] uppercase text-muted">
          {spalte.gruppen.length} {spalte.gruppen.length === 1 ? 'Angebot' : 'Angebote'}
        </p>
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.7rem]">
          {spalte.gruppen.map((g) => (
            <li
              class="pl-[0.7rem] border-l-3 border-(--sport-color) leading-[1.35]"
              style={`--sport-color:${farbe(g.sport)}`}
            >
              <a
                class="text-[0.95rem] font-semibold text-base-content no-underline hover:text-accent hover:underline"
                href={g.sport ? `/sportangebote/${g.sport}/` : '/sportangebote/'}>
                {g.title}
              </a>
              <span class="block text-[0.84rem] text-muted">
                {g.day} {g.time}
                {g.trainers && g.trainers.length > 0 && <> · {g.trainers.join(', ')}</>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

