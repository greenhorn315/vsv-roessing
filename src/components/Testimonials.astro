---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { nachOrder } from '../lib/reihenfolge';

const testimonials = (await getCollection('testimonials')).sort(nachOrder).map((eintrag) => eintrag.data);
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-8 md:gap-12">
  {
    testimonials.map((item) => (
      <figure class="min-[760px]:even:pt-12">
        <Icon name="quote" size={34} class="mb-3 text-accent" strokeWidth={0} />
        <blockquote>
          <p class="mb-3 font-display text-xl leading-snug font-medium text-pretty">
            {item.text}
          </p>
        </blockquote>
        <figcaption class="text-sm font-semibold text-primary">
          {item.author}
          <span class="block font-normal text-base-content/70">{item.role}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
