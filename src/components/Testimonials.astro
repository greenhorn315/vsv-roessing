---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { nachOrder } from '../lib/reihenfolge';

const testimonials = (await getCollection('testimonials')).sort(nachOrder).map((eintrag) => eintrag.data);
---

{/* Ab 760px versetzt: Jedes zweite Zitat rückt nach unten, das gibt der
    Sektion Rhythmus. */}
<div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-[clamp(2rem,4vw,3rem)]">
  {
    testimonials.map((item) => (
      <figure class="m-0 min-[760px]:even:pt-12 reveal">
        <Icon name="quote" size={34} class="text-coral mb-3" strokeWidth={0} />
        <blockquote class="m-0">
          <p class="font-display text-step-1 font-medium text-base-content leading-[1.4] m-0 mb-3 text-pretty">
            {item.text}
          </p>
        </blockquote>
        <figcaption class="text-[0.9rem] font-semibold text-primary">
          {item.author}
          <span class="block font-normal text-muted">{item.role}</span>
        </figcaption>
      </figure>
    ))
  }
</div>
