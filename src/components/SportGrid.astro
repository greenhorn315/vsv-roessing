---
import Pictogram from './Pictogram.astro';
import Icon from './Icon.astro';
import { ageGroupLabels, sportColorVar, AGE_GROUPS } from '../lib/labels';
import { getSports } from '../lib/sportarten';

interface Props {
  /** Filterleiste nach Altersgruppen anzeigen (Sportangebote-Seite). */
  withFilter?: boolean;
  /** Beschreibungstext auf den Karten anzeigen. */
  detailed?: boolean;
}

const { withFilter = false, detailed = false } = Astro.props;
const groups = AGE_GROUPS;
const sports = await getSports();

const chip = [
  'btn min-h-10 py-[0.4rem] px-4 border border-border-strong bg-base-100 text-base-content',
  'text-[0.9rem] font-semibold hover:transform-none hover:border-primary',
  'aria-pressed:bg-primary aria-pressed:border-primary aria-pressed:text-white',
];
---

{
  withFilter && (
    <div class="flex items-center flex-wrap gap-3 mb-6" data-sport-filter>
      <span class="font-semibold text-muted text-[0.9rem]" id="filterLabel">
        Passend für
      </span>
      {/* Umschalter als daisyUI-btn in Chip-Form: niedriger als die großen
          Buttons, ohne Anheben beim Hovern; der gedrückte ist grün. */}
      <div class="flex flex-wrap gap-[0.4rem]" role="group" aria-labelledby="filterLabel">
        <button type="button" class:list={['chip is-active', chip]} data-filter="alle" aria-pressed="true">
          Alle
        </button>
        {groups.map((group) => (
          <button type="button" class:list={['chip', chip]} data-filter={group} aria-pressed="false">
            {ageGroupLabels[group]}
          </button>
        ))}
      </div>
      <p class="basis-full m-0 text-[0.86rem] text-muted" role="status" data-filter-status />
    </div>
  )
}

{/* Feste Dreierreihen: bei neun Sportarten ergibt das ein 3x3-Raster. */}
<ul
  class="grid grid-cols-3 gap-4 list-none p-0 m-0 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1"
  data-sport-list
>
  {
    sports.map((sport) => (
      <li data-age-groups={sport.data.ageGroups.join(' ')}>
        <a
          class:list={[
            'group card h-full bg-base-100 text-base-content no-underline gap-2 py-6 px-4',
            'border border-border border-l-[5px] border-l-(color:--sport-color)',
            'transition-[translate,box-shadow,border-color] duration-[180ms] ease-[ease]',
            'hover:-translate-y-1 hover:shadow-md hover:border-(color:--sport-color)',
            'focus-visible:-translate-y-1 focus-visible:shadow-md focus-visible:border-(color:--sport-color)',
            'focus-visible:outline-[3px] focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-3',
          ]}
          href={`/sportangebote/${sport.id}/`}
          style={`--sport-color:${sportColorVar(sport.data.color)}`}
        >
          <Pictogram name={sport.data.pictogram} size={64} class="mb-[0.35rem]" />
          <h3 class="card-title text-[1.1rem] m-0">{sport.data.name}</h3>
          <p class="text-[0.92rem] text-muted m-0 grow">
            {detailed ? sport.data.description : sport.data.teaser}
          </p>
          <span class="inline-flex items-center gap-[0.35rem] mt-2 text-[0.86rem] font-semibold text-accent">
            Mehr erfahren
            <Icon
              name="arrowRight"
              size={16}
              class="transition-[translate] duration-[180ms] ease-[ease] group-hover:translate-x-[3px]"
            />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  const filter = document.querySelector<HTMLElement>('[data-sport-filter]');
  const list = document.querySelector<HTMLUListElement>('[data-sport-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (filter && list) {
    const chips = filter.querySelectorAll<HTMLButtonElement>('.chip');
    const items = list.querySelectorAll<HTMLLIElement>('li');

    filter.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!chip) return;

      const value = chip.dataset.filter ?? 'alle';
      chips.forEach((c) => {
        const active = c === chip;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });

      let visible = 0;
      items.forEach((item) => {
        const groups = (item.dataset.ageGroups ?? '').split(' ');
        const show = value === 'alle' || groups.includes(value);
        item.hidden = !show;
        if (show) visible++;
      });

      if (status) {
        status.textContent =
          value === 'alle'
            ? `${visible} Sportarten – alle Altersgruppen`
            : `${visible} von ${items.length} Sportarten passen zu dieser Auswahl`;
      }
    });
  }
</script>
