---
import Pictogram from './Pictogram.astro';
import Icon from './Icon.astro';
import { ageGroupLabels, sportColorVar, AGE_GROUPS } from '../lib/labels';
import { getSports } from '../lib/sportarten';

interface Props {
  /** Filterleiste nach Altersgruppen anzeigen (Sportangebote-Seite). */
  withFilter?: boolean;
  /** Beschreibungstext auf den Karten anzeigen. */
  detailed?: boolean;
}

const { withFilter = false, detailed = false } = Astro.props;
const groups = AGE_GROUPS;
const sports = await getSports();

const chip = 'btn btn-sm btn-outline btn-primary aria-pressed:bg-primary aria-pressed:text-primary-content';
---

{
  withFilter && (
    <div class="flex items-center flex-wrap gap-3 mb-6" data-sport-filter>
      <span class="text-sm font-semibold text-base-content/70" id="filterLabel">
        Passend für
      </span>
      {/* Umschalter als daisyUI-btn in Chip-Form: niedriger als die großen
          Buttons, ohne Anheben beim Hovern; der gedrückte ist grün. */}
      <div class="flex flex-wrap gap-1.5" role="group" aria-labelledby="filterLabel">
        <button type="button" class:list={['chip', chip]} data-filter="alle" aria-pressed="true">
          Alle
        </button>
        {groups.map((group) => (
          <button type="button" class:list={['chip', chip]} data-filter={group} aria-pressed="false">
            {ageGroupLabels[group]}
          </button>
        ))}
      </div>
      <p class="basis-full text-sm text-base-content/70" role="status" data-filter-status />
    </div>
  )
}

{/* Feste Dreierreihen: bei neun Sportarten ergibt das ein 3x3-Raster. */}
<ul
  class="grid grid-cols-3 gap-4 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1"
  data-sport-list
>
  {
    sports.map((sport) => (
      <li data-age-groups={sport.data.ageGroups.join(' ')}>
        <a
          class:list={[
            'group card h-full gap-2 bg-base-100 px-4 py-6',
            'border border-l-4 border-base-300 border-l-(--sport-color)',
            'transition hover:-translate-y-1 hover:border-(--sport-color) hover:shadow-md',
            'focus-visible:-translate-y-1 focus-visible:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
          ]}
          href={`/sportangebote/${sport.id}/`}
          style={`--sport-color:${sportColorVar(sport.data.color)}`}
        >
          <Pictogram name={sport.data.pictogram} size={64} class="mb-1.5" />
          <h3 class="card-title text-lg">{sport.data.name}</h3>
          <p class="grow text-sm text-base-content/70">
            {detailed ? sport.data.description : sport.data.teaser}
          </p>
          <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-accent">
            Mehr erfahren
            <Icon
              name="arrowRight"
              size={16}
              class="transition group-hover:translate-x-1"
            />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<script>
  const filter = document.querySelector<HTMLElement>('[data-sport-filter]');
  const list = document.querySelector<HTMLUListElement>('[data-sport-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (filter && list) {
    const chips = filter.querySelectorAll<HTMLButtonElement>('.chip');
    const items = list.querySelectorAll<HTMLLIElement>('li');

    filter.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
      if (!chip) return;

      const value = chip.dataset.filter ?? 'alle';
      chips.forEach((c) => {
        const active = c === chip;
        c.setAttribute('aria-pressed', String(active));
      });

      let visible = 0;
      items.forEach((item) => {
        const groups = (item.dataset.ageGroups ?? '').split(' ');
        const show = value === 'alle' || groups.includes(value);
        item.hidden = !show;
        if (show) visible++;
      });

      if (status) {
        status.textContent =
          value === 'alle'
            ? `${visible} Sportarten – alle Altersgruppen`
            : `${visible} von ${items.length} Sportarten passen zu dieser Auswahl`;
      }
    });
  }
</script>
