---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
// Vereinswappen, 275 × 320 px mit Transparenz; ausgeliefert als WebP (mit
// Alphakanal) in der Anzeigegröße und doppelt so groß für feine Displays.
import logo from '../assets/logo-vsv.png';
import { navigation, site } from '../lib/site';

// Pfade und Links enden auf „/“ (trailingSlash: 'always'). Beide Seiten
// ohne Schrägstrich vergleichen, damit /sportangebote/dart/ den Punkt
// „Sportangebote“ markiert, /sportangebote-xyz/ aber nicht.
const stripSlash = (p: string) => p.replace(/\/+$/, '') || '/';
const path = stripSlash(Astro.url.pathname);
const isActive = (href: string) => {
  const target = stripSlash(href);
  return target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);
};

// Menüpunkte (daisyUI-menu). Breit: Pillen nebeneinander; bis 940px:
// untereinander im aufklappbaren Panel. daisyUI nimmt den Fokusrahmen weg,
// deshalb setzen wir unseren (3px Korall) ausdrücklich wieder.
const linkBase = [
  'flex items-center gap-[0.45rem] rounded-full px-[0.85rem] py-[0.55rem]',
  'text-[0.95rem] whitespace-nowrap no-underline transition-colors duration-150',
  'focus-visible:outline-3 focus-visible:outline-solid focus-visible:outline-accent focus-visible:outline-offset-3',
  'max-[940px]:rounded-sm max-[940px]:px-4 max-[940px]:py-[0.9rem] max-[940px]:text-[1.05rem]',
];
// Aktive Seite nicht nur über Farbe kennzeichnen (WCAG 1.4.1): zusätzlich fett.
const linkNormal = [
  'font-medium text-base-content',
  // daisyUI tönt fokussierte Punkte grau; bei uns zeigt nur der Rahmen den Fokus.
  'not-aria-[current=page]:focus-visible:bg-transparent',
  'not-aria-[current=page]:hover:bg-tint-green not-aria-[current=page]:hover:text-primary',
  'aria-[current=page]:bg-primary aria-[current=page]:text-white aria-[current=page]:font-semibold',
  'max-[940px]:border-b max-[940px]:border-border',
];
const linkCta = [
  'bg-accent text-white font-semibold ml-[0.35rem]',
  'hover:bg-accent-hover hover:text-white aria-[current=page]:bg-accent-hover',
  'max-[940px]:justify-center max-[940px]:ml-0 max-[940px]:mt-3 max-[940px]:min-h-12',
];
---

<header
  id="siteHeader"
  class="sticky top-0 z-100 border-b border-transparent bg-base-200/88 backdrop-blur-[10px] backdrop-saturate-[1.4] transition-[border-color,box-shadow] duration-200 data-scrolled:border-border data-scrolled:shadow-sm"
>
  <div
    class="navbar group mx-auto min-h-header max-w-site justify-between gap-4 px-[clamp(1rem,4vw,1.5rem)] py-0"
  >
    <a class="flex items-center gap-2.5 py-2 no-underline" href="/">
      {/* Vereinswappen. Das Bild trägt alt="", weil der Vereinsname direkt
         daneben als Text steht – sonst läse ein Screenreader ihn doppelt. */}
      <Image
        class="h-12 w-auto shrink-0"
        src={logo}
        alt=""
        width={41}
        height={48}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
      />
      <span class="flex flex-col leading-[1.15]">
        <strong class="font-display text-[1.1rem] text-primary">{site.shortName}</strong>
        <span class="text-[0.72rem] text-muted">von {site.founded} e.V.</span>
      </span>
    </a>

    {/* Menüknopf fürs Handy. Öffnet das Menü als Popover: Der Browser
       übernimmt Escape, Klick daneben und die Rückkehr des Fokus. */}
    <button
      class="btn btn-ghost btn-square size-12 min-h-12 rounded-sm border border-border text-primary hover:translate-y-0 min-[941px]:hidden"
      id="navToggle"
      type="button"
      popovertarget="mainNav"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mainNav"
    >
      <Icon name="menu" size={26} class="group-has-[#mainNav:popover-open]:hidden" />
      <Icon name="close" size={26} class="hidden group-has-[#mainNav:popover-open]:block" />
    </button>

    {/* Bis 940px ein Popover in der obersten Ebene (top layer). Das umgeht
       auch den backdrop-filter des Headers, der ein fixiertes Panel sonst
       einfangen würde. Breit überschreiben min-[941px]:-Klassen die
       Popover-Vorgaben des Browsers, und die Liste steht in der Zeile. */}
    <nav
      id="mainNav"
      popover
      aria-label="Hauptnavigation"
      class="fixed inset-x-0 top-[calc(var(--spacing-header)+1px)] bottom-auto m-0 max-h-[calc(100dvh-var(--spacing-header))] w-full overflow-y-auto overscroll-contain border-0 border-b border-border bg-base-100 px-[clamp(1rem,4vw,1.5rem)] pt-4 pb-6 text-base-content shadow-lg -translate-y-1.5 opacity-0 transition-[opacity,translate,display,overlay] transition-discrete duration-200 open:translate-y-0 open:opacity-100 starting:open:-translate-y-1.5 starting:open:opacity-0 min-[941px]:static min-[941px]:flex min-[941px]:max-h-none min-[941px]:w-auto min-[941px]:translate-y-0 min-[941px]:overflow-visible min-[941px]:border-0 min-[941px]:bg-transparent min-[941px]:p-0 min-[941px]:opacity-100 min-[941px]:shadow-none"
    >
      <ul
        class="menu menu-horizontal m-0 list-none items-center gap-1 p-0 [--menu-active-bg:var(--color-primary)] [--menu-active-fg:#fff] max-[940px]:flex max-[940px]:w-full max-[940px]:flex-col max-[940px]:items-stretch max-[940px]:gap-[0.35rem]"
      >
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[linkBase, item.cta ? linkCta : linkNormal]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <Icon name={item.icon} />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mainNav');

  if (toggle && nav) {
    // Zustand und Beschriftung des Knopfs nachführen; beim Öffnen wie
    // bisher direkt auf den ersten Menüpunkt springen.
    nav.addEventListener('toggle', (event) => {
      const open = (event as ToggleEvent).newState === 'open';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    // Wird das Fenster breiter, gehört das Menü wieder in die Zeile.
    const mobile = window.matchMedia('(max-width: 940px)');
    mobile.addEventListener('change', () => {
      if (!mobile.matches && nav.matches(':popover-open')) nav.hidePopover();
    });
  }

  // Trennlinie und Schatten am Header erst, wenn wirklich gescrollt wird.
  const header = document.getElementById('siteHeader');
  const onScroll = () => {
    header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
