---
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img
        class="brand-mark"
        src="/logo-vsv.png"
        alt=""
        width="41"
        height="48"
        decoding="async"
      />
      <span class="brand-text">
        <strong>{site.shortName}</strong>
        <span>von {site.founded} e.V.</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mainNav"
    >
      <Icon name="menu" size={26} class="icon-menu" />
      <Icon name="close" size={26} class="icon-close" />
    </button>

    <nav class="main-nav" id="mainNav" aria-label="Hauptnavigation">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { 'nav-link--cta': item.cta }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <Icon name={item.icon} />
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* Trennlinie erst zeigen, wenn wirklich gescrollt wird. */
  :global(body.is-scrolled) .site-header {
    border-bottom-color: var(--c-border);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: var(--header-height);
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 1.5rem);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    padding-block: var(--sp-2);
  }
  /* Vereinswappen. Das Bild traegt alt="", weil der Vereinsname direkt
     daneben als Text steht – sonst laese ein Screenreader ihn doppelt. */
  .brand-mark {
    height: 48px;
    width: auto;
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--c-primary);
  }
  .brand-text > span {
    font-size: 0.72rem;
    color: var(--c-text-muted);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--c-text);
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.16s ease, color 0.16s ease;
  }
  .nav-link:hover {
    background: var(--c-tint-green);
    color: var(--c-primary);
  }
  /* Aktive Seite nicht nur über Farbe kennzeichnen (WCAG 1.4.1). */
  .nav-link[aria-current='page'] {
    background: var(--c-primary);
    color: #fff;
    font-weight: 600;
  }
  .nav-link--cta {
    background: var(--c-accent-ink);
    color: #fff;
    font-weight: 600;
    margin-left: 0.35rem;
  }
  .nav-link--cta:hover {
    background: var(--c-accent-ink-hover);
    color: #fff;
  }
  .nav-link--cta[aria-current='page'] {
    background: var(--c-accent-ink-hover);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    width: 48px;
    height: 48px;
    place-items: center;
    color: var(--c-primary);
  }
  .nav-toggle :global(.icon-close) { display: none; }
  .nav-toggle[aria-expanded='true'] :global(.icon-menu) { display: none; }
  .nav-toggle[aria-expanded='true'] :global(.icon-close) { display: block; }

  @media (max-width: 940px) {
    .nav-toggle { display: grid; }

    .main-nav {
      /* Nicht `fixed`: der backdrop-filter des Headers macht diesen zum
         Containing Block, wodurch ein fixiertes Panel kollabieren würde. */
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - var(--header-height));
      background: var(--c-surface);
      box-shadow: var(--shadow-lg);
      border-bottom: 1px solid var(--c-border);
      flex-direction: column;
      align-items: stretch;
      justify-content: start;
      gap: 0.35rem;
      padding: var(--sp-4) clamp(1rem, 4vw, 1.5rem) var(--sp-5);
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateY(-6px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    }
    .main-nav.is-open {
      opacity: 1;
      transform: none;
      visibility: visible;
    }
    .nav-link {
      padding: 0.9rem 1rem;
      font-size: 1.05rem;
      border-bottom: 1px solid var(--c-border);
      border-radius: var(--radius-sm);
    }
    .nav-link--cta {
      justify-content: center;
      margin: var(--sp-3) 0 0;
      border-bottom: none;
      min-height: 48px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mainNav');

  if (toggle && nav) {
    const mobile = window.matchMedia('(max-width: 940px)');

    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
      document.body.style.overflow = open ? 'hidden' : '';
      // Geschlossenes Menü darf nicht per Tab erreichbar sein.
      if (mobile.matches) nav.inert = !open;
      if (open) nav.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    const syncViewport = () => {
      if (mobile.matches) {
        nav.inert = !nav.classList.contains('is-open');
      } else {
        nav.inert = false;
        setOpen(false);
      }
    };

    syncViewport();
    mobile.addEventListener('change', syncViewport);

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // Schatten am Header erst nach dem ersten Scrollen.
  const onScroll = () => {
    document.body.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
