---
import { spielDatum, type Spiel } from '../lib/spielplan';

interface Props {
  heading: string;
  spiele: Spiel[];
  /** Beschriftung der Tabelle für Screenreader. */
  caption: string;
  /** Spalte „Team“ nur zeigen, wenn eine Sportart mehrere Mannschaften stellt. */
  withTeam?: boolean;
}

const { heading, spiele, caption, withTeam = false } = Astro.props;

// daisyUI-table mit den bisherigen Abständen, Linien in der Rahmenfarbe.
// Die Linie unter der letzten Zeile lässt daisyUI selbst weg.
const kopf =
  'px-[0.9rem] py-[0.7rem] border-border text-[0.78rem] font-bold uppercase tracking-[0.04em] whitespace-normal';
const zelle = 'px-[0.9rem] py-[0.65rem] border-border align-top';
---

{
  spiele.length > 0 && (
    <section class="section--tight">
      <div class="container">
        <div class="section-head">
          <h2>{heading}</h2>
          <p><slot /></p>
        </div>

        {/* Auf schmalen Bildschirmen scrollt die Tabelle waagerecht. */}
        <div class="overflow-x-auto border border-border rounded-sm bg-base-100">
          <table class="table border-collapse rounded-none min-w-[34rem] text-[0.92rem]">
            <caption class="sr-only">{caption}</caption>
            <thead class="text-muted">
              <tr>
                <th scope="col" class={kopf}>Datum</th>
                <th scope="col" class={kopf}>Zeit</th>
                {withTeam && <th scope="col" class={kopf}>Team</th>}
                <th scope="col" class={kopf}>Gegner</th>
                <th scope="col" class={kopf}>Wo</th>
              </tr>
            </thead>
            <tbody>
              {spiele.map((spiel) => (
                <tr>
                  <td class={`${zelle} whitespace-nowrap tabular-nums`}>{spielDatum(spiel.date)}</td>
                  <td class={`${zelle} whitespace-nowrap tabular-nums`}>{spiel.time}</td>
                  {withTeam && <td class={zelle}>{spiel.team}</td>}
                  <td class={zelle}>
                    {spiel.opponent}
                    {spiel.note && <span class="ml-[0.4rem] text-[0.82rem] text-muted">{spiel.note}</span>}
                  </td>
                  <td class={zelle}>
                    {/* Heim: dunkles Braun auf Gelb, 8,4:1 Kontrast. */}
                    <span
                      class:list={[
                        'badge h-auto rounded-full align-baseline whitespace-nowrap px-[0.55rem] py-[0.15rem] text-[0.78rem] font-bold leading-[inherit]',
                        spiel.home
                          ? 'badge-warning border-transparent text-[#4a3600]'
                          : 'bg-transparent border-border text-muted',
                      ]}
                    >
                      {spiel.home ? 'Heim' : 'Auswärts'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )
}
