---
import Container from './Container.astro';
import SectionHead from './SectionHead.astro';
import { getEntry } from 'astro:content';
import { spielDatum, type Spiel } from '../lib/spielplan';
import { spielKnoten } from '../lib/seo';

interface Props {
  sport: string;
  heading: string;
  spiele: Spiel[];
  caption: string;
  withTeam?: boolean;
}

const { sport, heading, spiele, caption, withTeam = false } = Astro.props;

if (!Astro.isPrerendered) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
}

const sportName = (await getEntry('sportarten', sport))?.data.name ?? sport;
const ereignisse = await spielKnoten(sport, sportName, Astro.site!.origin);
const jsonLdText = JSON.stringify({ '@context': 'https://schema.org', '@graph': ereignisse }).replace(/</g, '\\u003c');

const kopf = 'text-xs font-bold tracking-wide uppercase whitespace-normal';
const zelle = 'align-top';
---

{
  spiele.length > 0 && (
    <section class="pb-16 md:pb-20">
      <script is:inline type="application/ld+json" set:html={jsonLdText} />
      <Container>
        <SectionHead title={heading}>
          <p><slot /></p>
        </SectionHead>

        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
          <table class="table min-w-[34rem]">
            <caption class="sr-only">{caption}</caption>
            <thead>
              <tr>
                <th scope="col" class={kopf}>Datum</th>
                <th scope="col" class={kopf}>Zeit</th>
                {withTeam && <th scope="col" class={kopf}>Team</th>}
                <th scope="col" class={kopf}>Gegner</th>
                <th scope="col" class={kopf}>Wo</th>
              </tr>
            </thead>
            <tbody>
              {spiele.map((spiel) => (
                <tr>
                  <td class={`${zelle} whitespace-nowrap tabular-nums`}>{spielDatum(spiel.date)}</td>
                  <td class={`${zelle} whitespace-nowrap tabular-nums`}>{spiel.time}</td>
                  {withTeam && <td class={zelle}>{spiel.team}</td>}
                  <td class={zelle}>
                    {spiel.opponent}
                    {spiel.note && <span class="ml-1.5 text-xs text-base-content/70">{spiel.note}</span>}
                  </td>
                  <td class={zelle}>
                    <span class:list={['badge badge-sm font-bold whitespace-nowrap', spiel.home ? 'badge-warning' : 'badge-ghost']}>
                      {spiel.home ? 'Heim' : 'Auswärts'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Container>
    </section>
  )
}
