---
import Icon from './Icon.astro';

const panels = [
  {
    variant: 'families' as const,
    icon: 'users' as const,
    title: 'Für Familien',
    lead: 'Mehrere Kinder, ein fairer Beitrag. Und ihr wisst immer, was diese Woche ansteht.',
    points: [
      'Gedeckelter Familienbeitrag, egal wie viele Kinder mitmachen',
      'Kompakte Trainingsübersicht statt vollem Eventkalender',
      'Parkplätze direkt an Sporthalle & Sportplatz',
    ],
    cta: { label: 'Familienbeitrag ansehen', href: '/mitglied-werden/#familienrechner' },
  },
  {
    variant: 'youth' as const,
    icon: 'sparkle' as const,
    title: 'Für Jugendliche & junge Erwachsene',
    lead: 'Unverbindlich reinschnuppern, deine Crew treffen, dabei bleiben.',
    points: [
      'Kostenloses, unverbindliches Probetraining',
      'Community-Austausch über WhatsApp',
      'Aktuelle Einblicke auf Instagram',
    ],
    cta: { label: 'Probetraining anfragen', href: '/kontakt/#probetraining' },
  },
  {
    variant: 'later' as const,
    icon: 'sport' as const,
    title: 'Für die zweite Lebenshälfte',
    lead: 'Viele unserer Aktiven sind über 70, einige über 90 – und stehen jede Woche in der Halle oder auf dem Rad. Anfangen kann man in jedem Alter.',
    points: [
      'Frauengymnastik donnerstags am Vormittag, Yoga am Freitagabend',
      'Freitagsradler: im Sommerhalbjahr aufs Rad, im Winter in die Halle',
      'Beim Fußball die Ü32 und die Ü40, dazu der Dart-Abend im Dorfbrunnen',
    ],
    cta: { label: 'Trainingszeiten ansehen', href: '/sportangebote/' },
  },
];

const hintergrund = {
  families: 'bg-base-300',
  youth: 'bg-accent/10',
  later: 'bg-warning/20',
} as const;
---

<div class="grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-4">
  {
    panels.map((panel) => (
      <article
        class:list={[
          'card items-start rounded-3xl p-7 text-base md:p-10',
          hintergrund[panel.variant],
        ]}
      >
        <span
          class="mb-4 grid size-11 place-items-center rounded-full bg-base-100 text-primary shadow-sm"
          aria-hidden="true"
        >
          <Icon name={panel.icon} size={22} />
        </span>
        <h3 class="mb-2 text-2xl">{panel.title}</h3>
        <p class="mb-4 text-base-content/70">{panel.lead}</p>
        <ul class="mb-8 flex flex-col gap-2.5">
          {panel.points.map((point) => (
            <li class="flex items-start gap-2.5 leading-snug">
              <Icon name="check" size={17} class="mt-0.5 stroke-[2.6] text-secondary" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
        <a class="btn mt-auto btn-outline btn-primary" href={panel.cta.href}>
          {panel.cta.label}
        </a>
      </article>
    ))
  }
</div>
