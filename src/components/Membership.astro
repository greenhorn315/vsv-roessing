---
import Icon from './Icon.astro';
import FamilyCalculator from './FamilyCalculator.astro';
import { fees, joinSteps } from '../data/membership';

interface Props {
  /** Auf der Startseite als Teaser, auf der Unterseite als volle Sektion. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const euro = new Intl.NumberFormat('de-DE', {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
});
---

<div class="membership reveal">
  <div class="section-head">
    <h2>Mitmachen war noch nie so einfach</h2>
    <p>
      Formular ausfüllen, unterschreiben, ab geht's aufs Feld – für kleines
      Geld und mit großem Spaß.
    </p>
  </div>

  <div class="membership-grid">
    <div>
      <table class="fees">
        <caption class="visually-hidden">Mitgliedsbeiträge pro Monat</caption>
        <thead>
          <tr>
            <th scope="col">Beitrag</th>
            <th scope="col">Pro Monat</th>
          </tr>
        </thead>
        <tbody>
          {
            fees.map((fee) => (
              <tr>
                <th scope="row">
                  {fee.label}
                  {fee.note && <span class="fees__note">{fee.note}</span>}
                </th>
                <td class="fees__price">{euro.format(fee.monthly)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <ol class="steps">
        {
          joinSteps.map((step, index) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="membership-ctas">
        <a class="btn btn--primary" href="/mitglied-werden#formulare">
          <Icon name="download" />
          Mitgliedsantrag herunterladen
        </a>
        {
          compact && (
            <a class="btn btn--ghost" href="/mitglied-werden">
              Alle Infos zur Mitgliedschaft
              <Icon name="arrowRight" size={16} />
            </a>
          )
        }
      </div>
    </div>

    <FamilyCalculator />
  </div>
</div>

<style>
  .membership {
    background: var(--c-surface);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--shadow-sm);
  }

  .membership-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  /* ---- Beitragstabelle ---- */
  .fees {
    width: 100%;
    border-collapse: collapse;
  }
  .fees th,
  .fees td {
    text-align: left;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--c-border);
  }
  .fees thead th {
    color: var(--c-text-muted);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .fees tbody th {
    font-weight: 500;
    font-family: var(--font-body);
    color: var(--c-text);
    font-size: 0.98rem;
  }
  .fees__note {
    display: block;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--c-text-muted);
  }
  .fees__price {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--c-primary);
    font-size: var(--step-1);
    white-space: nowrap;
  }
  .fees tbody tr:last-child th,
  .fees tbody tr:last-child td {
    border-bottom: none;
    background: var(--c-tint-green);
  }
  .fees tbody tr:last-child th { border-radius: var(--radius-sm) 0 0 var(--radius-sm); }
  .fees tbody tr:last-child td { border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }

  /* ---- Schritte ---- */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--sp-5);
    list-style: none;
    padding: 0;
    margin: var(--sp-7) 0 0;
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--c-accent-ink);
    color: #fff;
    font-weight: 700;
    font-family: var(--font-display);
    margin-bottom: var(--sp-3);
  }
  .step h3 {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }
  .step p {
    font-size: 0.9rem;
    color: var(--c-text-muted);
    margin: 0;
  }

  .membership-ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
  }

  @media (max-width: 900px) {
    .membership-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
