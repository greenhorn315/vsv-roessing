---
import Icon from './Icon.astro';
import FamilyCalculator from './FamilyCalculator.astro';
import { getBeitragsregeln, getFees, getJoinSteps } from '../lib/mitgliedschaft';

interface Props {
  /** Auf der Startseite als Teaser, auf der Unterseite als volle Sektion. */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const fees = await getFees();
const beitragsregeln = await getBeitragsregeln();
const joinSteps = await getJoinSteps();
// Zwei Nachkommastellen: 7,50 € wuerde sonst als 8 € erscheinen.
const euro = new Intl.NumberFormat('de-DE', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 2,
});

// Preise in der Tabelle: Monat und Jahr gleich gewichtet.
const preis = 'font-display font-semibold text-primary text-step-1 whitespace-nowrap';
---

<div class="card reveal bg-base-100 rounded-lg p-[clamp(1.5rem,4vw,3rem)] shadow-sm">
  <div class="section-head">
    <h2>Mitmachen war noch nie so einfach</h2>
    <p>
      Formular ausfüllen, unterschreiben, ab geht's aufs Feld – für kleines
      Geld und mit großem Spaß.
    </p>
  </div>

  <div class="grid grid-cols-[1.15fr_0.85fr] gap-[clamp(2rem,4vw,3rem)] items-start max-[900px]:grid-cols-1">
    <div>
      {/* Beitragstabelle: daisyUI-table mit Linien in Rahmenfarbe; die letzte
          Zeile (Familienbeitrag) grün hinterlegt mit runden Enden. */}
      <table class="table text-step-0 [&_:is(th,td)]:px-2 [&_:is(th,td)]:py-3 [&_:is(th,td)]:border-border">
        <caption class="sr-only">Mitgliedsbeiträge pro Monat und pro Jahr</caption>
        <thead class="text-muted font-semibold text-[0.78rem] uppercase tracking-[0.05em]">
          <tr>
            <th scope="col">Beitrag</th>
            <th scope="col">Pro Monat</th>
            <th scope="col">Pro Jahr</th>
          </tr>
        </thead>
        <tbody class="[&>tr:last-child>*]:bg-tint-green [&>tr:last-child>:first-child]:rounded-l-sm [&>tr:last-child>:last-child]:rounded-r-sm">
          {
            fees.map((fee) => (
              <tr>
                <th scope="row" class="font-medium text-base-content text-[0.98rem]">
                  {fee.label}
                  {fee.note && (
                    <span class="block text-[0.8rem] font-normal text-muted">{fee.note}</span>
                  )}
                </th>
                <td class={preis}>{euro.format(fee.monthly)}</td>
                <td class={preis}>{euro.format(fee.yearly)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <ul class="list-none p-0 mt-4 mb-8 flex flex-col gap-2 text-[0.9rem] leading-normal text-muted">
        {beitragsregeln.map((regel) => <li class="pl-4 border-l-2 border-border">{regel}</li>)}
      </ul>

      {/* So klappt der Beitritt. Bewusst kein daisyUI-steps: Das zentriert
          den Text und zieht eine Verbindungslinie – hier stehen die Schritte
          linksbündig nebeneinander, auf schmalen Bildschirmen untereinander. */}
      <ol class="list-none p-0 mt-11 mb-0 grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-6">
        {
          joinSteps.map((step, index) => (
            <li>
              <span
                class="grid place-items-center size-[34px] rounded-full bg-accent text-accent-content font-display font-bold mb-3"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="text-[1rem] mt-0 mb-1">{step.title}</h3>
              <p class="text-[0.9rem] text-muted m-0">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="flex items-center flex-wrap gap-4 mt-11">
        <a class="btn btn-accent" href="/mitglied-werden/#formulare">
          <Icon name="download" />
          Mitgliedsantrag herunterladen
        </a>
        {
          compact && (
            <a class="btn btn-link" href="/mitglied-werden/">
              Alle Infos zur Mitgliedschaft
              <Icon name="arrowRight" size={16} />
            </a>
          )
        }
      </div>
    </div>

    <FamilyCalculator />
  </div>
</div>
