---
import Icon from './Icon.astro';
import FamilyCalculator from './FamilyCalculator.astro';
import SectionHead from './SectionHead.astro';
import { getBeitragsregeln, getFees, getJoinSteps } from '../lib/mitgliedschaft';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const fees = await getFees();
const beitragsregeln = await getBeitragsregeln();
const joinSteps = await getJoinSteps();
const euro = new Intl.NumberFormat('de-DE', {
  style: 'currency',
  currency: 'EUR',
  minimumFractionDigits: 2,
});

const preis = 'font-display text-lg font-semibold whitespace-nowrap text-primary md:text-xl';
---

<div class="card rounded-3xl bg-base-100 p-6 text-base shadow-sm md:p-12">
  <SectionHead title="Mitmachen war noch nie so einfach">
    <p>
      Formular ausfüllen, unterschreiben, ab geht's aufs Feld – für kleines
      Geld und mit großem Spaß.
    </p>
  </SectionHead>

  <div class="grid grid-cols-[1.15fr_0.85fr] items-start gap-8 md:gap-12 max-[900px]:grid-cols-1">
    <div>
      <table class="table text-base">
        <caption class="sr-only">Mitgliedsbeiträge pro Monat und pro Jahr</caption>
        <thead class="text-xs tracking-wider uppercase">
          <tr>
            <th scope="col">Beitrag</th>
            <th scope="col">Pro Monat</th>
            <th scope="col">Pro Jahr</th>
          </tr>
        </thead>
        <tbody>
          {
            fees.map((fee) => (
              <tr class="last:bg-base-300">
                <th scope="row" class="font-medium">
                  {fee.label}
                  {fee.note && (
                    <span class="block text-xs font-normal text-base-content/70">{fee.note}</span>
                  )}
                </th>
                <td class={preis}>{euro.format(fee.monthly)}</td>
                <td class={preis}>{euro.format(fee.yearly)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <ul class="mt-4 mb-8 flex flex-col gap-2 text-sm text-base-content/70">
        {beitragsregeln.map((regel) => <li class="border-l-2 border-base-300 pl-4">{regel}</li>)}
      </ul>

      <ol class="mt-10 grid gap-6 sm:grid-cols-3">
        {
          joinSteps.map((step, index) => (
            <li>
              <span
                class="mb-3 grid size-9 place-items-center rounded-full bg-accent font-display font-bold text-accent-content"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              <h3 class="mb-1 text-base">{step.title}</h3>
              <p class="text-sm text-base-content/70">{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a class="btn btn-accent" href="/mitglied-werden/#formulare">
          <Icon name="download" />
          Mitgliedsantrag herunterladen
        </a>
        {
          compact && (
            <a class="link inline-flex items-center gap-1.5 font-semibold link-accent" href="/mitglied-werden/">
              Alle Infos zur Mitgliedschaft
              <Icon name="arrowRight" size={16} />
            </a>
          )
        }
      </div>
    </div>

    <FamilyCalculator />
  </div>
</div>
