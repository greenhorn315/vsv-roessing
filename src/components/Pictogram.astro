---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name?: string;
  size?: number;
  class?: string;
}

const { name, size = 64, class: className } = Astro.props;

const dateien = import.meta.glob<ImageMetadata>('/src/assets/piktogramme/*.png', {
  eager: true,
  import: 'default',
});
const bild = name ? dateien[`/src/assets/piktogramme/${name}.png`] : undefined;

if (name && !bild) {
  const vorhanden = Object.keys(dateien)
    .map((pfad) => pfad.replace(/^.*\/|\.png$/g, ''))
    .join(', ');
  throw new Error(
    `Piktogramm „${name}“ gibt es nicht in src/assets/piktogramme/. Vorhanden: ${vorhanden}`,
  );
}
---

{
  bild ? (
    <Image
      class:list={['block aspect-square h-auto', className]}
      src={bild}
      alt=""
      width={size}
      height={size}
      densities={[1, 2]}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span
      class:list={[
        'block aspect-square rounded-[17%] border border-dashed border-base-content/20',
        className,
      ]}
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
    />
  )
}
