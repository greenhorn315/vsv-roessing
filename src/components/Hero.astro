---
import Icon from './Icon.astro';
import HeroKarussell from './HeroKarussell.astro';
import { site, slogan, clubAge } from '../lib/site';
import { getSportNames } from '../lib/sportarten';

const sportNames = (await getSportNames()).join(', ');
---

<section class="site-hero pt-[clamp(2.5rem,1rem+5vw,4.5rem)] pb-0 overflow-x-clip">
  <div
    class="container grid grid-cols-[1.05fr_0.95fr] gap-[clamp(2rem,4vw,3.5rem)] items-center max-[940px]:grid-cols-1"
  >
    <div class="hero-copy">
      <p class="inline-flex items-center gap-2 bg-primary text-white py-[0.35rem] px-[0.9rem] rounded-full text-[0.85rem] font-semibold m-0 mb-4">
        <span class="status status-warning" aria-hidden="true"></span>
        {clubAge} Jahre {site.shortName}
      </p>
      <h1 class="max-w-[15ch] mb-4 max-[940px]:max-w-[20ch]">{slogan}</h1>
      <p class="lead">
        {/* „in jedem Alter“ statt einer eigenen Nennung der Älteren: Der Verein
            hat viele ältere Mitglieder, aber niemand soll hier in eine
            Schublade gesteckt werden. */}
        {sportNames} – für Kinder, Jugendliche, Familien und Erwachsene in
        jedem Alter.
        Schon ab <strong class="text-base-content font-bold whitespace-nowrap">4&nbsp;€ im Monat</strong> dabei.
      </p>
      <div class="flex gap-3 flex-wrap mt-8">
        <a class="btn btn-accent" href="/mitglied-werden/">
          <Icon name="join" />
          Jetzt Mitglied werden
        </a>
        <a class="btn btn-outline" href="/kontakt/#probetraining">
          <Icon name="sport" />
          Probetraining vereinbaren
        </a>
      </div>
      <p class="flex items-center gap-[0.45rem] m-0 mt-4 text-[0.9rem] text-muted">
        <Icon name="check" size={16} class="text-secondary stroke-[2.5]" />
        Probetraining kostenlos &amp; unverbindlich – einfach vorbeikommen.
      </p>
    </div>

    <div class="relative max-[940px]:-order-1 max-[940px]:max-w-[520px]">
      {/* Bogenform als wiedererkennbares Gestaltungselement. Mobil flacher
          als am Desktop, damit der Aufruf zum Handeln in Sichtweite bleibt –
          aber nicht so flach, dass von den Hochformaten zu wenig übrig
          bleibt. */}
      <HeroKarussell
        class="aspect-[4/5] rounded-[clamp(80px,18vw,180px)_var(--radius-lg)_var(--radius-lg)_var(--radius-lg)] shadow-lg max-[940px]:aspect-[4/3] max-[940px]:rounded-lg"
      />
      <svg
        class="absolute -left-[38px] -bottom-[28px] size-[190px] -z-1 opacity-90 max-[940px]:hidden"
        viewBox="0 0 200 200"
        aria-hidden="true"
      >
        <path
          d="M10 190 C 10 100, 100 100, 100 10"
          fill="none"
          stroke="var(--color-coral)"
          stroke-width="12"
          stroke-linecap="round"
        />
      </svg>
      <p
        class="absolute -right-3 bottom-[26px] m-0 size-[84px] rounded-full bg-sun text-[#3F2E00] grid place-content-center text-center leading-[1.1] shadow-md font-display max-[940px]:-right-2 max-[940px]:-bottom-[18px] max-[940px]:size-[72px]"
      >
        <strong class="block text-[0.72rem] uppercase tracking-[0.08em] font-semibold">seit</strong>
        <span class="text-[1.35rem] font-bold">{site.founded}</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Einzig verbliebenes CSS: das gestaffelte Einblenden der Texte beim
     Laden. Keyframes lassen sich nicht als Utility schreiben, und global.css
     ist dafür der falsche Ort. */
  .hero-copy > :global(*) {
    animation: rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .hero-copy > :global(*:nth-child(2)) { animation-delay: 0.08s; }
  .hero-copy > :global(*:nth-child(3)) { animation-delay: 0.16s; }
  .hero-copy > :global(*:nth-child(4)) { animation-delay: 0.24s; }
  .hero-copy > :global(*:nth-child(5)) { animation-delay: 0.32s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
  }
</style>
