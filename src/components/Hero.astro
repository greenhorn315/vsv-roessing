---
import Icon from './Icon.astro';
import HeroKarussell from './HeroKarussell.astro';
import Container from './Container.astro';
import { site, slogan, clubAge } from '../lib/site';
import { getSportNames } from '../lib/sportarten';

const sportNames = (await getSportNames()).join(', ');
---

<section class="overflow-x-clip pt-10 md:pt-16">
  <Container class="grid grid-cols-[1.05fr_0.95fr] items-center gap-8 md:gap-14 max-[940px]:grid-cols-1">
    <div>
      <p class="badge mb-4 gap-2 border-0 bg-primary py-3.5 font-semibold text-primary-content">
        <span class="status status-warning" aria-hidden="true"></span>
        {clubAge} Jahre {site.shortName}
      </p>
      <h1 class="mb-4 max-w-[15ch] text-4xl md:text-5xl lg:text-6xl max-[940px]:max-w-[20ch]">{slogan}</h1>
      <p class="max-w-[46ch] text-lg text-base-content/70 md:text-xl">
        {sportNames} – für Kinder, Jugendliche, Familien und Erwachsene in
        jedem Alter.
        Schon ab <strong class="font-bold whitespace-nowrap text-base-content">4&nbsp;€ im Monat</strong> dabei.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-lg btn-accent" href="/mitglied-werden/">
          <Icon name="join" />
          Jetzt Mitglied werden
        </a>
        <a class="btn btn-lg btn-outline btn-primary" href="/kontakt/#probetraining">
          <Icon name="sport" />
          Probetraining vereinbaren
        </a>
      </div>
      <p class="mt-4 flex items-center gap-2 text-sm text-base-content/70">
        <Icon name="check" size={16} class="text-secondary stroke-[2.5]" />
        Probetraining kostenlos &amp; unverbindlich – einfach vorbeikommen.
      </p>
    </div>

    <div class="relative isolate max-[940px]:-order-1 max-[940px]:max-w-[520px]">
      <HeroKarussell
        class="aspect-4/5 rounded-3xl rounded-tl-[clamp(80px,18vw,180px)] shadow-lg max-[940px]:aspect-4/3 max-[940px]:rounded-tl-3xl"
      />
      <svg
        class="absolute -bottom-7 -left-10 -z-1 size-48 text-accent/70 max-[940px]:hidden"
        viewBox="0 0 200 200"
        aria-hidden="true"
      >
        <path
          d="M10 190 C 10 100, 100 100, 100 10"
          fill="none"
          stroke="currentColor"
          stroke-width="12"
          stroke-linecap="round"
        />
      </svg>
      <p
        class="absolute -right-3 bottom-6 grid size-21 place-content-center rounded-full bg-warning text-center font-display leading-tight text-warning-content shadow-md max-[940px]:-right-2 max-[940px]:-bottom-4 max-[940px]:size-18"
      >
        <strong class="block text-xs font-semibold tracking-widest uppercase">seit</strong>
        <span class="text-xl font-bold">{site.founded}</span>
      </p>
    </div>
  </Container>
</section>
